# /etc/systemd/system/hehermes-rele-publico.service
# La entrada pública del relé de avisos (hehermes_avisos.rele.publico): por donde llegan los avisos de los vigías de
# otros servidores y, desde la 1.3.0, la oficina de permisos de App Attest (las apps, sin credencial). TLS 1.3 en el puerto alto de rele-publico.ini, con la maquinaria de la pasarela (el mismo 404, los
# mismos límites), y detrás, el relé en 127.0.0.1:8791 con la misma credencial. La instala `instalar.sh --rele-publico`.
[Unit]
Description=HeHermes: la entrada pública del relé de avisos (TLS)
Documentation=file:///opt/hehermes-avisos/src/README.md
Wants=network-online.target hehermes-rele.socket
After=network-online.target hehermes-rele.socket
# Si aun así se cae en bucle (lo que no es de configuración), a los 5 arranques en 2 minutos systemd deja de intentarlo.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Su propio usuario, en el grupo del relé solo para leer credenciales.ini (root:hh-rele 0640). La clave .p8 es de
# hh-rele y 0600: esta entrada, que es lo único del relé que da a internet, no la puede leer.
User=hh-rele-publico
Group=hh-rele-publico
SupplementaryGroups=hh-rele
ExecStart=/opt/hehermes-avisos/venv/bin/python -I -B -m hehermes_avisos.rele.publico servir --config /etc/hehermes-avisos/rele-publico.ini
# La clave del certificado es de root (0600): le llega como credencial de systemd, y manda sobre la ruta del ini.
LoadCredential=clave:/etc/hehermes-avisos/rele-publico/clave.pem
# La clave con la que la oficina firma los permisos de avisos (App Attest), también de root.
LoadCredential=permisos:/etc/hehermes-avisos/rele-publico/permisos.pem
# Las claves de App Attest atestadas (permisos.db): lo único que escribe.
StateDirectory=hehermes-rele-publico
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
# 78 (EX_CONFIG): un secreto que no se lee o la configuración rota. Reiniciar no lo arregla: falla una vez, con el motivo
# en el registro (journalctl -u hehermes-rele-publico), y espera a un `systemctl restart`.
RestartPreventExitStatus=78
UMask=0077
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Ni lo del vigía, ni la .p8 (por si alguien la dejara legible para el grupo), ni los secretos de la pasarela.
InaccessiblePaths=-/etc/hehermes-avisos/vigia -/var/lib/hehermes-vigia -/etc/hehermes-avisos/rele/AuthKey.p8 -/etc/hehermes-pasarela -/etc/nginx -/etc/wireguard -/etc/swanctl
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
