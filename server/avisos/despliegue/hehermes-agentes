class Ayudante:
    """Todas las órdenes, sin sockets: el `atender` de abajo solo traduce. `orden` devuelve `(respuesta, continuación o
    None)`: la continuación es el trabajo, que corre con la conexión ya cerrada."""

    def __init__(self, config: Config, sistema: Sistema | None = None):
        self.config = config
        self.sistema = sistema or Sistema(config)
        self.trabajos = Trabajos(config, self.sistema)

    def orden(self, peticion) -> tuple:
        orden = peticion.get("orden") if isinstance(peticion, dict) else None
        if orden not in CAMPOS:
            raise Rechazo(400, "orden_desconocida", "Orden desconocida")
        if set(peticion) - CAMPOS[orden]:
            raise _invalido("La orden trae algo que no es suyo")
        if orden == "listar":
            return self.listar(), None
        if orden == "ver":
            return self.ver(peticion.get("perfil")), None
        if orden == "crear":
            return self.crear(peticion)
        if orden == "cambiar":
            return self.cambiar(peticion)
        if orden == "borrar":
            return self.borrar(peticion.get("perfil"))
        if orden == "trabajo":
            datos = self.trabajos.leer(validar_id(peticion.get("id")))
            if datos is None:
                raise Rechazo(404, "trabajo_desconocido", "Ese trabajo no existe o ya caducó")
            return dict(datos, ok=True), None
        return self.sincronizar_memoria(), None

    # -- Lo común

    def _hermes_principal(self, argumentos: list, carpeta: str | None = None, plazo: float = PLAZO_HERMES) -> tuple:
        """`hermes -p default …`: todo lo que lanza el ayudante es del principal. Con HERMES_HOME en la raíz, la CLI
        sigue el perfil que dejara pegado `hermes profile use` (`_apply_profile_override`), y `profile create --clone`
        clona el ACTIVO (`_resolve_clone_source(None)`: `get_hermes_home()`): sin `-p`, el agente nuevo saldría clonado
        de ese y no del principal. `delete`, `describe`, `export` y `config set` tampoco han de depender de él."""
        hermes = self.sistema.hermes()
        if not hermes:
            _decir("no encuentro hermes")
            return 127, ""
        return self.sistema.ejecutar([hermes, "-p", PRINCIPAL] + argumentos, self.sistema.entorno_de_hermes(),
                                     plazo=plazo, carpeta=carpeta)

    def _hermes_del_perfil(self, perfil: str, argumentos: list, plazo: float = PLAZO_CONFIG) -> tuple:
        """`hermes -p <perfil> …`: lo de un agente en su casa (su `config.yaml`), nunca en la del activo."""
        hermes = self.sistema.hermes()
        if not hermes:
            _decir("no encuentro hermes")
            return 127, ""
        return self.sistema.ejecutar([hermes, "-p", validar_perfil(perfil)] + argumentos,
                                     self.sistema.entorno_de_hermes(), plazo=plazo)

    def _mientras(self, id_: str, funcion):
        """Lo que devuelve `funcion()`, que corre en otro hilo mientras este le da latido al trabajo cada `LATIDO`
        segundos: un `hermes` de minutos (la copia y el borrado) o un reinicio con drenaje no lo dejan sin latido, y la
        lista no lo da por acabado (ni adopta lo de un perfil a medias)."""
        resultado = {}

        def correr():
            try:
                resultado["valor"] = funcion()
            except BaseException as error:  # noqa: BLE001 — se vuelve a lanzar en este hilo
                resultado["error"] = error

        hilo = threading.Thread(target=correr, daemon=True)
        hilo.start()
        while True:
            hilo.join(LATIDO)
            if not hilo.is_alive():
                break
            self.trabajos.poner(id_)
        if "error" in resultado:
            raise resultado["error"]
        return resultado.get("valor")

    def perfiles(self) -> list:
        """Los agentes: los perfiles que Hermes serviría (`perfiles_de_hermes`), sin lanzar `hermes`, que tarda."""
        return self.sistema.como_hermes(lambda: perfiles_de_hermes(self.config.casa))

    def _exportaciones(self, perfil: str) -> str:
        casa = self.config.casa if perfil == PRINCIPAL else os.path.join(self.config.casa, "profiles", perfil)
        return os.path.join(casa, "exports")

    def _modo_de_las_claves(self) -> int:
        return 0o600 if self.config.usuario else 0o640

    def _servidos(self, perfiles: list) -> dict:
        """Si Hermes sirve cada agente con su clave: una mirada corta a cada uno (`/p/<perfil>/api/sessions`, con la
        clave que usa la pasarela), todas a la vez. Sin su clave, no; la que no contesta en su plazo, tampoco."""
        servidos = {perfil: False for perfil in perfiles if perfil != PRINCIPAL}
        claves = {perfil: leer_clave(self.config.claves_pasarela, perfil) for perfil in servidos}

        def mirar(perfil: str, clave: str) -> None:
            estado, _ = self.sistema.http("/p/%s/api/sessions?limit=1" % perfil, clave, plazo=PLAZO_MIRADA)
            servidos[perfil] = estado == 200

        hilos = [threading.Thread(target=mirar, args=(perfil, clave), daemon=True)
                 for perfil, clave in claves.items() if clave is not None]
        if hilos:
            self.sistema.puerto()  # antes de los hilos: con un Hermes de otro usuario, leerlo es un proceso hijo
        for hilo in hilos:
            hilo.start()
        limite = time.monotonic() + PLAZO_MIRADA + 0.5
        for hilo in hilos:
            hilo.join(max(0.0, limite - time.monotonic()))
        return dict(servidos)

    def _agente(self, perfil: str, leido: dict, servido: bool = False) -> dict:
        ficha = leido.get("ficha") or {}
        if perfil == PRINCIPAL:
            return {"perfil": PRINCIPAL, "nombre": ficha.get("nombre", "Hermes"), "color": ficha.get("color", "indigo"),
                    "expresion": ficha.get("expresion", "serena"), "descripcion": ficha.get("descripcion", ""),
                    "memoria": "propia", "principal": True, "servido": True, "modelo": leido.get("modelo")}
        return {"perfil": perfil, "nombre": ficha.get("nombre", perfil), "color": ficha.get("color", "grafito"),
                "expresion": ficha.get("expresion", "serena"), "descripcion": ficha.get("descripcion", ""),
                "memoria": ficha.get("memoria", "propia"), "principal": False, "servido": servido,
                "modelo": leido.get("modelo")}

    def _leer(self, perfiles: list, alma: bool = False, preparar: bool = False) -> dict:
        return self.sistema.como_hermes(lambda: leer_perfiles(self.config.casa, perfiles, alma, preparar))

    def _casa_es_un_perfil(self) -> bool:
        """Un Hermes que ya es un perfil de otro (`<raíz>/profiles/<nombre>`: el de quien corre `hermes -p <nombre>`).
        Sus perfiles no irían dentro de su casa sino al lado, y lo que haría ahí Hermes no se ha comprobado (tarea 7 del
        plan): no se crean agentes."""
        return os.path.basename(os.path.dirname(self.config.casa)) == "profiles"

    def _caben(self, cuantos: int) -> int:
        if self._casa_es_un_perfil():
            return 0
        try:
            libre = self.sistema.libre(self.config.casa)
        except OSError:
            libre = 0
        return 0 if libre < LIBRE_MINIMO else max(0, TOPE_AGENTES - cuantos)

    # -- Listar y ver

    def listar(self) -> dict:
        """En menos de un segundo: sin `hermes`, sin esperar al cerrojo de un trabajo, y con una mirada a cada agente."""
        self.trabajos.limpiar()
        perfiles = self.perfiles()
        en_marcha = self.trabajos.en_marcha()
        leidos = self._leer(perfiles, preparar=not en_marcha)
        if not en_marcha:
            # Con un trabajo en marcha no: un perfil a medio crear tiene todavía en su .env la clave del principal.
            self._adoptar(leidos)
        servidos = self._servidos(perfiles)
        return {"ok": True, "agentes": [self._agente(PRINCIPAL, leidos.get(PRINCIPAL, {}))]
                + [self._agente(perfil, leidos.get(perfil, {}), servidos.get(perfil, False)) for perfil in perfiles],
                "caben": self._caben(len(perfiles))}

    def _adoptar(self, leidos: dict) -> None:
        """La clave del .env de cada perfil, para la pasarela y el vigía, si no la tienen ya: la de un perfil que ya
        estaba, o la de uno que una copia restaurada ha cambiado (manda el .env). Su .env no se toca."""
        for perfil, leido in leidos.items():
            clave = leido.get("clave")
            if perfil == PRINCIPAL or clave is None:
                continue
            for carpeta in (self.config.claves_pasarela, self.config.claves_vigia):
                if leer_clave(carpeta, perfil) != clave:
                    try:
                        escribir_clave(carpeta, perfil, clave, self._modo_de_las_claves())
                        _decir("perfil %s: su clave, copiada de su .env" % perfil)
                    except OSError as error:
                        _decir("perfil %s: no puedo copiar su clave (%s)" % (perfil, type(error).__name__))

    def ver(self, perfil) -> dict:
        perfil = validar_perfil(perfil)
        if perfil != PRINCIPAL and perfil not in self.perfiles():
            raise Rechazo(404, "agente_desconocido", "Ese agente no existe")
        leido = self._leer([perfil], alma=True).get(perfil)
        if leido is None:
            raise Rechazo(404, "agente_desconocido", "Ese agente no existe")
        personalidad = None if perfil == PRINCIPAL else personalidad_de(leido.get("alma") or "")
        servido = self._servidos([perfil]).get(perfil, False)
        return dict(self._agente(perfil, leido, servido), personalidad=personalidad, ok=True)

    # -- Crear

    def crear(self, peticion: dict) -> tuple:
        datos = validar_creacion(peticion)
        if self._casa_es_un_perfil():
            raise Rechazo(409, "tope_de_agentes", "Este Hermes es un perfil de otro: aquí no caben agentes")
        # Antes del cerrojo y del 202: que Hermes lo ofrece (o el 409 o el 502 de §18.10, sin crear nada).
        datos["elegido"] = None if datos["modelo"] is None else self._comprobar_modelo(datos["modelo"])
        if not self.trabajos.tomar():
            raise Rechazo(409, "en_curso", "Ya hay un trabajo de los agentes en marcha")
        try:
            perfiles = self.perfiles()
            if len(perfiles) >= TOPE_AGENTES:
                raise Rechazo(409, "tope_de_agentes", "Ya hay %d agentes" % TOPE_AGENTES)
            if self.sistema.libre(self.config.casa) < LIBRE_MINIMO:
                raise Rechazo(507, "sin_espacio", "No hay sitio en el disco para otro agente")
            ocupados = set(perfiles) | set(self.sistema.como_hermes(lambda: nombres_en_profiles(self.config.casa)))
            perfil = perfil_de(datos["nombre"], ocupados)
            id_ = self.trabajos.nuevo("crear", perfil)
        except BaseException:
            self.trabajos.soltar()
            raise
        _decir("crear %s (trabajo %s): pedido, memoria %s, %s" % (perfil, id_[:8], datos["memoria"],
                                                                   "otro modelo" if datos["elegido"] else
                                                                   "el modelo del principal"))

        def continuar():
            try:
                self._crear(id_, perfil, datos)
            finally:
                self.trabajos.soltar()

        return {"ok": True, "http": 202, "trabajo": id_, "perfil": perfil}, continuar

    def _crear(self, id_: str, perfil: str, datos: dict) -> None:
        self.trabajos.poner(id_, estado="creando")
        creado = False
        try:
            orden = ["profile", "create", perfil, "--clone"]
            if datos["descripcion"]:
                orden.append("--description=" + datos["descripcion"])
            codigo, _ = self._mientras(id_, lambda: self._hermes_principal(orden))
            if codigo != 0:
                _decir("crear %s: hermes profile create ha salido con %d" % (perfil, codigo))
                raise Fallo("hermes")
            creado = True
            # Lo primero, su clave: el --clone le ha dejado la del principal, y Hermes aparca un perfil con la clave de
            # otro hasta que cambia su .env.
            clave = clave_nueva()
            self.sistema.como_hermes(lambda: poner_clave_del_perfil(self.config.casa, perfil, clave))
            self.trabajos.poner(id_)
            exportaciones = self._exportaciones(perfil)
            creado_en = int(self.sistema.ahora())
            self.sistema.como_hermes(lambda: preparar_perfil(self.config.casa, perfil, datos, exportaciones,
                                                             self.config.espera_flock, creado_en))
            self.trabajos.poner(id_)
            # El modelo elegido, antes de que Hermes lo sirva: su primer turno ya es con él. Sin elegir, el del
            # principal, que ha copiado `--clone`.
            if datos["elegido"] is not None:
                self._poner_modelo(id_, perfil, datos["elegido"])
                self.trabajos.poner(id_)
            try:
                for carpeta in (self.config.claves_pasarela, self.config.claves_vigia):
                    escribir_clave(carpeta, perfil, clave, self._modo_de_las_claves())
            except OSError:
                raise Fallo("clave") from None
            self._que_lo_sirva(id_, perfil, clave)
        except Fallo as fallo:
            if creado and fallo.motivo != "no_se_sirve":
                self._deshacer(id_, perfil)
            self.trabajos.poner(id_, estado="fallo", motivo=fallo.motivo)
            _decir("crear %s (trabajo %s): fallo (%s)" % (perfil, id_[:8], fallo.motivo))
            return
        except Exception as error:  # noqa: BLE001 — el trabajo falla, el ayudante dice cuál
            if creado:
                self._deshacer(id_, perfil)
            self.trabajos.poner(id_, estado="fallo", motivo="interna")
            _decir("crear %s (trabajo %s): fallo (interna: %s)" % (perfil, id_[:8], type(error).__name__))
            return
        self.trabajos.poner(id_, estado="hecho")
        _decir("crear %s (trabajo %s): hecho" % (perfil, id_[:8]))

    def _deshacer(self, id_: str, perfil: str) -> None:
        """Lo de un perfil a medio crear: él (recién nacido, no tiene nada que copiar) y sus claves."""
        codigo, _ = self._mientras(id_, lambda: self._hermes_principal(["profile", "delete", perfil, "--yes"],
                                                                       plazo=PLAZO_HERMES_LARGO))
        for carpeta in (self.config.claves_pasarela, self.config.claves_vigia):
            quitar_clave(carpeta, perfil)
        _decir("crear %s: deshecho%s" % (perfil, "" if codigo == 0 else " (hermes profile delete ha salido con %d)"
                                          % codigo))

    def _contesta(self, id_: str, perfil: str, clave: str, plazo: float) -> bool:
        """Si Hermes sirve el perfil con su clave (`/p/<perfil>/api/sessions`), mirándolo cada `CADA` segundos hasta
        `plazo`."""
        limite = self.sistema.ahora() + plazo
        while True:
            estado, _ = self.sistema.http("/p/%s/api/sessions?limit=1" % perfil, clave, plazo=CADA)
            if estado == 200:
                return True
            if self.sistema.ahora() >= limite:
                return False
            self.trabajos.poner(id_)
            self.sistema.dormir(CADA)

    def _que_lo_sirva(self, id_: str, perfil: str, clave: str) -> None:
        """Un Hermes que ya sirve otros perfiles sirve en caliente los nuevos, y vuelve a mirar el que cambia su .env,
        al pedírselo por su socket de control y en su repaso de cada 30 s (`gateway/run_profile_reconcile.py`): se le
        pide ya, y se le espera hasta `PLAZO_SERVIDO`, **sin reiniciarlo**. Si contesta que aún no sirve otros perfiles
        (`multiplex: false`), es el primer agente: `_servirlo_reiniciando`. Si no lo sirve a tiempo, `no_se_sirve`, y el
        perfil se queda (la lista dice cuándo se sirve)."""
        respuesta = self.sistema.repasar_perfiles()
        if respuesta is None:
            _decir("crear %s: el socket de control de Hermes no contesta: lo verá en su repaso" % perfil)
        elif respuesta.get("multiplex") is False:
            self._servirlo_reiniciando(id_, perfil, clave, respuesta)
            return
        if not self._contesta(id_, perfil, clave, PLAZO_SERVIDO):
            _decir("crear %s: Hermes no lo sirve en %d s" % (perfil, PLAZO_SERVIDO))
            raise Fallo("no_se_sirve")

    def _servirlo_reiniciando(self, id_: str, perfil: str, clave: str, respuesta: dict) -> None:
        """El primer agente (`CALMA`): Hermes aún no sirve otros perfiles, porque lo decide al arrancar y arrancó con el
        principal solo. Se reinicia su unidad **una vez**, con drenaje, en un rato tranquilo y con
        `gateway.multiplex_profiles: true` ya en su config.yaml. Solo así: nunca con `hermes gateway migrate`, que si no
        reconoce la unidad instala otra o lanza otra pasarela suelta (`_restart_default` de
        `hermes_cli/gateway_migrate.py`), ni con `hermes gateway restart`, que puede reescribir la unidad
        (`refresh_systemd_unit_if_needed`); ni una unidad que no esté en marcha con la pasarela de Hermes dentro. Si algo
        no sale, `no_se_sirve`: el perfil se queda, y Hermes lo servirá en su próximo reinicio."""
        servidos = [PRINCIPAL] + sorted({p for p in respuesta.get("served_profiles") or []
                                         if isinstance(p, str) and PATRON_PERFIL.fullmatch(p) and p != PRINCIPAL})
        _decir("crear %s: este Hermes aún no sirve otros perfiles (gateway.multiplex_profiles se decide al arrancar): "
               "lo reinicio una vez, con drenaje, en un rato tranquilo" % perfil)
        self._que_se_pueda_reiniciar(perfil, servidos)
        self.trabajos.poner(id_, paso="esperando_a_hermes")
        self._esperar_calma_y_poner_el_flag(id_, perfil, servidos)
        # Otra vez, justo antes: en los minutos de espera alguien ha podido reiniciarlo (y ya los sirve), pararlo o
        # cambiarle el proceso. Sin confirmar que sigue sin servir otros perfiles, no se reinicia.
        otra = self.sistema.repasar_perfiles()
        if otra is not None and otra.get("multiplex") is not False:
            _decir("crear %s: Hermes ya sirve otros perfiles: no lo reinicio" % perfil)
            if not self._contesta(id_, perfil, clave, PLAZO_SERVIDO):
                _decir("crear %s: Hermes no lo sirve en %d s" % (perfil, PLAZO_SERVIDO))
                raise Fallo("no_se_sirve")
            return
        if otra is None:
            _decir("crear %s: no reinicio Hermes: su socket de control ya no contesta; %s" % (perfil, LUEGO))
            raise Fallo("no_se_sirve")
        self._que_se_pueda_reiniciar(perfil, servidos)
        self.trabajos.poner(id_, paso="reiniciando_hermes")
        _decir("crear %s: reinicio %s (una vez, con drenaje)" % (perfil, self.config.unidad))
        inicio = self.sistema.ahora()
        if not self._mientras(id_, self.sistema.reiniciar_hermes):
            _decir("crear %s: systemctl restart %s ha fallado: %s" % (perfil, self.config.unidad, LUEGO))
            raise Fallo("no_se_sirve")
        _decir("crear %s: Hermes reiniciado en %d s; lo espero hasta %d s" % (perfil, self.sistema.ahora() - inicio,
                                                                            PLAZO_TRAS_REINICIO))
        if not self._contesta(id_, perfil, clave, PLAZO_TRAS_REINICIO):
            _decir("crear %s: Hermes, reiniciado, no lo sirve en %d s" % (perfil, PLAZO_TRAS_REINICIO))
            raise Fallo("no_se_sirve")

    def _vista(self, servidos: list) -> dict | None:
        """`vista_de_hermes`, como el dueño de Hermes; None si no se puede mirar."""
        try:
            return self.sistema.como_hermes(lambda: vista_de_hermes(self.config.casa, servidos))
        except (OSError, Fallo):
            return None

    def _que_se_pueda_reiniciar(self, perfil: str, servidos: list) -> None:
        """Que su unidad esté en marcha y, si se sabe qué proceso es la pasarela de Hermes, que corra dentro de ella
        (por su cgroup). Arrancar una unidad parada sería otra pasarela al lado de la que sirve (en tmux, en un
        contenedor), y reiniciar otra no cambiaría nada; reiniciar la suya en marcha nunca añade otra pasarela."""
        unidad = self.config.unidad
        estado = self.sistema.estado_de_la_unidad()
        porque = None
        if estado.get("LoadState") != "loaded" or estado.get("ActiveState") != "active":
            porque = "su unidad %s no está en marcha (%s)" % (unidad, estado.get("ActiveState")
                                                               or "systemd no contesta")
        else:
            pid = (self._vista(servidos) or {}).get("pid")
            texto = self.sistema.cgroup(pid) if pid else None
            suya = unidad if texto is None else unidad_del_cgroup(texto)
            if suya != unidad:
                porque = "no corre en su unidad %s (sino en %s)" % (unidad, suya or "ninguna")
        if porque:
            _decir("crear %s: no reinicio Hermes: %s; %s" % (perfil, porque, LUEGO))
            raise Fallo("no_se_sirve")

    def _esperar_calma_y_poner_el_flag(self, id_: str, perfil: str, servidos: list) -> None:
        """Hasta `PLAZO_CALMA`, mirándolo cada `CADA_CALMA`: en cuanto está tranquilo, el flag (`_poner_el_flag`), y
        otra mirada, que la orden tarda unos segundos. Sin un rato tranquilo, ni flag ni reinicio."""
        limite = self.sistema.ahora() + PLAZO_CALMA
        puesto, dicho = False, None
        while True:
            vista = self._vista(servidos)
            if vista is None:
                tranquilo, que, porque = False, "nada", "no puedo mirar lo que hace"
            else:
                tranquilo, que, porque = rato_tranquilo(vista, self.sistema.ahora())
            if tranquilo and puesto:
                return
            if tranquilo:
                self._poner_el_flag(id_, perfil)
                puesto = True
                continue
            if que != dicho:
                _decir("crear %s: espero a un rato tranquilo de Hermes (%s)" % (perfil, porque))
                dicho = que
            if self.sistema.ahora() >= limite:
                _decir("crear %s: Hermes no ha estado tranquilo en %d s (%s): no lo reinicio; %s"
                       % (perfil, PLAZO_CALMA, porque, LUEGO))
                raise Fallo("no_se_sirve")
            self.trabajos.poner(id_)
            self.sistema.dormir(CADA_CALMA)

    def _poner_el_flag(self, id_: str, perfil: str) -> None:
        """`gateway.multiplex_profiles: true` en el config.yaml del principal, con la orden de Hermes (`hermes config
        set`: el mismo escritor, que conserva los comentarios, que usa su `gateway migrate`, `_write_multiplex_flag`).
        Y que de verdad esté: una orden que sale bien sin escribir nada (una instalación gestionada) no vale."""
        _decir("crear %s: hermes config set gateway.multiplex_profiles true" % perfil)
        codigo, _ = self._mientras(id_, lambda: self._hermes_principal(
            ["config", "set", "gateway.multiplex_profiles", "true"], plazo=PLAZO_CONFIG))
        if codigo != 0:
            _decir("crear %s: hermes config set ha salido con %d: no lo reinicio; %s" % (perfil, codigo, LUEGO))
            raise Fallo("no_se_sirve")
        try:
            puesto = self.sistema.como_hermes(lambda: config_de_hermes_multiplexa(self.config.casa))
        except (OSError, Fallo):
            puesto = False
        if not puesto:
            _decir("crear %s: hermes config set no ha dejado gateway.multiplex_profiles en su config.yaml: no lo "
                   "reinicio; %s" % (perfil, LUEGO))
            raise Fallo("no_se_sirve")

    # -- Cambiar

    def cambiar(self, peticion: dict) -> tuple:
        """Lo de la casa del perfil, al momento. La descripción va también a Hermes (`hermes profile describe`, que
        tarda): después de contestar, con la conexión ya cerrada y el cerrojo tomado hasta acabar. El modelo es un
        trabajo (`_cambiar_modelo`)."""
        perfil = validar_perfil(peticion.get("perfil"))
        cambios = validar_cambios(peticion)
        if "modelo" in cambios:
            return self._cambiar_modelo(perfil, cambios["modelo"])
        if perfil == PRINCIPAL and "personalidad" in cambios:
            raise Rechazo(409, "no_se_cambia_el_principal", "Del principal solo se cambian el nombre, la cara y la "
                                                            "descripción")
        if not self.trabajos.tomar():
            raise Rechazo(409, "en_curso", "Ya hay un trabajo de los agentes en marcha")
        try:
            if perfil != PRINCIPAL and perfil not in self.perfiles():
                raise Rechazo(404, "agente_desconocido", "Ese agente no existe")
            exportaciones = self._exportaciones(perfil)
            try:
                self.sistema.como_hermes(lambda: cambiar_perfil(self.config.casa, perfil, cambios, exportaciones))
            except (OSError, Fallo):
                raise Rechazo(500, "error", "No se ha podido cambiar el agente") from None
            leido = self._leer([perfil]).get(perfil, {})
            servido = self._servidos([perfil]).get(perfil, False)
        except BaseException:
            self.trabajos.soltar()
            raise
        _decir("cambiar %s: %s" % (perfil, ", ".join(sorted(cambios))))
        respuesta = dict(self._agente(perfil, leido, servido), ok=True, http=200)
        if "descripcion" not in cambios or perfil == PRINCIPAL:
            self.trabajos.soltar()
            return respuesta, None

        def continuar():
            try:
                codigo, _ = self._hermes_principal(["profile", "describe", perfil, cambios["descripcion"]])
                if codigo != 0:
                    _decir("cambiar %s: hermes profile describe ha salido con %d" % (perfil, codigo))
            finally:
                self.trabajos.soltar()

        return respuesta, continuar

    # -- El modelo (§18.11)

    def _opciones_de_hermes(self) -> dict:
        """Lo que ofrece Hermes: `/api/model/options` del principal, en 127.0.0.1 con su clave (la de su .env). Es lo
        que tiene configurado y autenticado, y lo que hereda un clon (su config.yaml y su .env). Sin respuesta que se
        entienda, `502 sin_modelos`."""
        try:
            clave = self.sistema.como_hermes(lambda: clave_del_env(_leer_env_principal(self.config.casa)))
        except (OSError, Fallo):
            clave = None
        estado, cuerpo = self.sistema.http("/api/model/options", clave, plazo=PLAZO_OPCIONES)
        opciones = opciones_de_hermes(cuerpo) if estado == 200 else None
        if opciones is None:
            _decir("modelo: Hermes no ha dicho qué modelos tiene (%s)" % (estado or "sin respuesta"))
            raise Rechazo(502, "sin_modelos", "Hermes no ha dicho qué modelos tiene")
        return opciones

    def _comprobar_modelo(self, modelo: dict) -> dict:
        """El modelo pedido, si Hermes lo ofrece ahora: con los nombres de su proveedor (su `slug` y sus alias, como el
        `custom:<nombre>` de uno propio), para escribir el que ya tenga el perfil. Si no, `409 modelo_desconocido`.
        Nunca un texto de la app a ciegas: lo que se escribe sale de esta lista."""
        for fila in self._opciones_de_hermes()["proveedores"]:
            if modelo["proveedor"] in fila["nombres"] and modelo["modelo"] in fila["modelos"]:
                return {"proveedor": fila["slug"], "nombres": fila["nombres"], "modelo": modelo["modelo"]}
        raise Rechazo(409, "modelo_desconocido", "Hermes no ofrece ese modelo")

    def _poner_modelo(self, id_: str, perfil: str, elegido: dict | None) -> None:
        """El modelo de un perfil: lee su `model:` y el del principal, hace lo que falte con `hermes -p <perfil> config
        set|unset` (`pasos_del_modelo`) y mira que ha quedado así. `elegido` None es «como Hermes»: el que tiene el
        principal ahora. Del proveedor se escribe el nombre que ya tenga el perfil, o el principal, si es uno de los
        suyos. Si algo no sale, su config.yaml vuelve a ser el de antes, byte a byte, y `Fallo("modelo")`."""
        casa = self.config.casa
        try:
            antes = self.sistema.como_hermes(lambda: leer_config(casa, perfil))
            del_principal = self.sistema.como_hermes(lambda: leer_config(casa, PRINCIPAL))
        except (OSError, Fallo):
            antes = None
        if antes is None:
            _decir("modelo %s: no puedo leer su config.yaml" % perfil)
            raise Fallo("modelo")
        actual, principal = bloque_del_modelo(texto_de(antes)), bloque_del_modelo(texto_de(del_principal))
        if elegido is None:
            proveedor, modelo = principal.get("provider"), principal.get("default") or principal.get("model")
            if not es_un_modelo(modelo) or not (proveedor is None or es_un_proveedor(proveedor)):
                _decir("modelo %s: no entiendo el modelo del principal" % perfil)
                raise Fallo("modelo")
        else:
            modelo = elegido["modelo"]
            proveedor = next((p for p in (actual.get("provider"), principal.get("provider"))
                              if p in elegido["nombres"]), elegido["proveedor"])
        try:
            pasos, objetivo = pasos_del_modelo(actual, principal, proveedor, modelo)
        except Fallo:
            _decir("modelo %s: ese proveedor no se puede poner desde aquí (se configura con su dirección o su clave)"
                   % perfil)
            raise
        hecho = True
        for paso in pasos:
            orden = ["config", "unset", "model." + paso[1]] if paso[0] == "unset" else \
                ["config", "set", "model." + paso[1], paso[2]]
            codigo, _ = self._mientras(id_, lambda orden=orden: self._hermes_del_perfil(perfil, orden))
            if codigo != 0:
                _decir("modelo %s: hermes config %s model.%s ha salido con %d" % (perfil, paso[0], paso[1], codigo))
                hecho = False
                break
        if hecho:
            try:
                despues = self.sistema.como_hermes(lambda: leer_config(casa, perfil))
            except (OSError, Fallo):
                despues = None
            hecho = queda_como(bloque_del_modelo(texto_de(despues)), objetivo)
            if not hecho:
                _decir("modelo %s: su config.yaml no ha quedado como debía" % perfil)
        if not hecho:
            try:
                self.sistema.como_hermes(lambda: devolver_config(casa, perfil, antes))
                _decir("modelo %s: su config.yaml, como estaba" % perfil)
            except (OSError, Fallo) as error:
                _decir("modelo %s: no he podido devolver su config.yaml (%s)" % (perfil, type(error).__name__))
            raise Fallo("modelo")
        _decir("modelo %s: puesto (%s)" % (perfil, ", ".join("%s %s" % (p[0], p[1]) for p in pasos) or "ya estaba"))

    def _cambiar_modelo(self, perfil: str, modelo: dict | None) -> tuple:
        """`PATCH` con `modelo`: un trabajo (`modelo`, en `cambiando` mientras dura), porque cada `hermes` tarda unos
        segundos y un cambio de proveedor son varios. Lo que se puede saber antes, antes del 202: que Hermes lo ofrece y
        que el agente existe. El del principal no se cambia desde aquí (es el de Hermes)."""
        if perfil == PRINCIPAL:
            raise Rechazo(409, "no_se_cambia_el_principal", "El modelo de Hermes se cambia en Hermes")
        elegido = None if modelo is None else self._comprobar_modelo(modelo)
        if not self.trabajos.tomar():
            raise Rechazo(409, "en_curso", "Ya hay un trabajo de los agentes en marcha")
        try:
            if perfil not in self.perfiles():
                raise Rechazo(404, "agente_desconocido", "Ese agente no existe")
            id_ = self.trabajos.nuevo("modelo", perfil)
        except BaseException:
            self.trabajos.soltar()
            raise
        _decir("modelo %s (trabajo %s): pedido, %s" % (perfil, id_[:8], "como el del principal" if elegido is None
                                                        else "otro"))

        def continuar():
            try:
                self.trabajos.poner(id_, estado="cambiando")
                try:
                    self._poner_modelo(id_, perfil, elegido)
                except Fallo as fallo:
                    self.trabajos.poner(id_, estado="fallo", motivo=fallo.motivo)
                    _decir("modelo %s (trabajo %s): fallo (%s)" % (perfil, id_[:8], fallo.motivo))
                    return
                except Exception as error:  # noqa: BLE001
                    self.trabajos.poner(id_, estado="fallo", motivo="interna")
                    _decir("modelo %s (trabajo %s): fallo (interna: %s)" % (perfil, id_[:8], type(error).__name__))
                    return
                self.trabajos.poner(id_, estado="hecho")
                _decir("modelo %s (trabajo %s): hecho" % (perfil, id_[:8]))
            finally:
                self.trabajos.soltar()

        return {"ok": True, "http": 202, "trabajo": id_, "perfil": perfil}, continuar

    # -- Borrar

    def borrar(self, perfil) -> tuple:
        perfil = validar_perfil(perfil)
        if perfil == PRINCIPAL:
            raise Rechazo(409, "no_se_borra_el_principal", "El principal no se borra")
        if not self.trabajos.tomar():
            raise Rechazo(409, "en_curso", "Ya hay un trabajo de los agentes en marcha")
        try:
            if perfil not in self.perfiles():
                raise Rechazo(404, "agente_desconocido", "Ese agente no existe")
            id_ = self.trabajos.nuevo("borrar", perfil)
        except BaseException:
            self.trabajos.soltar()
            raise
        _decir("borrar %s (trabajo %s): pedido" % (perfil, id_[:8]))

        def continuar():
            try:
                self._borrar(id_, perfil)
            finally:
                self.trabajos.soltar()

        return {"ok": True, "http": 202, "trabajo": id_}, continuar

    def _carpeta_de_copias(self) -> str:
        if self.config.copias:
            return self.config.copias
        return os.path.join(self.sistema.casa_del_dueno() or "/root", "hehermes-copias", "agentes")

    def _borrar(self, id_: str, perfil: str) -> None:
        self.trabajos.poner(id_, estado="borrando")
        try:
            copias = self._carpeta_de_copias()
            try:
                antes = self.sistema.como_hermes(lambda: preparar_copias(copias))
            except OSError:
                raise Fallo("copia") from None
            nombre = "%s-%s.tar.gz" % (perfil, time.strftime("%Y%m%d-%H%M%S", time.gmtime(self.sistema.ahora())))
            # Los dos `hermes` de borrar tardan minutos (`PLAZO_HERMES_LARGO`); mientras, el trabajo late.
            codigo, _ = self._mientras(id_, lambda: self._hermes_principal(
                ["profile", "export", perfil, "--output", os.path.join(copias, nombre)], carpeta=copias,
                plazo=PLAZO_HERMES_LARGO))
            nuevas = self.sistema.como_hermes(lambda: copias_nuevas(copias, antes)) if codigo == 0 else []
            if not nuevas:
                _decir("borrar %s: sin copia (hermes profile export ha salido con %d): no se borra" % (perfil, codigo))
                raise Fallo("copia")
            self.trabajos.poner(id_)
            codigo, _ = self._mientras(id_, lambda: self._hermes_principal(["profile", "delete", perfil, "--yes"],
                                                                           plazo=PLAZO_HERMES_LARGO))
            if perfil in self.perfiles():
                _decir("borrar %s: hermes profile delete ha salido con %d" % (perfil, codigo))
                raise Fallo("hermes")
            if codigo != 0:
                # Sale con error si no pudo cerrar la identidad del perfil en la base del principal
                # (`ProfileIdentitySettlementPending`), con su lápida puesta y su carpeta ya borrada: para Hermes, el
                # perfil ya no está, y aquí tampoco.
                _decir("borrar %s: hermes profile delete ha salido con %d, pero el perfil ya no está: lo doy por "
                       "borrado" % (perfil, codigo))
            for carpeta in (self.config.claves_pasarela, self.config.claves_vigia):
                quitar_clave(carpeta, perfil)
        except Fallo as fallo:
            self.trabajos.poner(id_, estado="fallo", motivo=fallo.motivo)
            _decir("borrar %s (trabajo %s): fallo (%s)" % (perfil, id_[:8], fallo.motivo))
            return
        except Exception as error:  # noqa: BLE001
            self.trabajos.poner(id_, estado="fallo", motivo="interna")
            _decir("borrar %s (trabajo %s): fallo (interna: %s)" % (perfil, id_[:8], type(error).__name__))
            return
        self.trabajos.poner(id_, estado="hecho")
        _decir("borrar %s (trabajo %s): hecho, con su copia" % (perfil, id_[:8]))

    # -- La memoria que se comparte

    def sincronizar_memoria(self) -> dict:
        perfiles = self.perfiles()
        leidos = self._leer(perfiles)
        comparten = [p for p in perfiles if (leidos.get(p, {}).get("ficha") or {}).get("memoria") == "comparte"]
        if not comparten:
            return {"ok": True, "copiados": 0, "saltados": 0}
        previo = _leer_json(self.trabajos.ruta("memoria.json"))
        previo = previo if isinstance(previo, dict) else {}
        espera = self.config.espera_flock
        hecho = self.sistema.como_hermes(lambda: sincronizar(self.config.casa, [PRINCIPAL] + comparten, previo,
                                                             espera))
        if len(hecho["cambiados"]) > 1:
            _decir("memoria compartida: %d cambiaron desde la vuelta anterior; gana la de %s"
                   % (len(hecho["cambiados"]), hecho["ganador"]))
        for perfil in hecho["saltados"]:
            _decir("memoria compartida: %s se salta esta vuelta (su flock no llega en %g s)" % (perfil, espera))
        if hecho["copiados"]:
            _decir("memoria compartida: la de %s, copiada a %d" % (hecho["ganador"], hecho["copiados"]))
        estado = dict(previo)
        estado.update(hecho["estado"])
        try:
            self.trabajos._preparar()
            _escribir_json(self.trabajos.ruta("memoria.json"),
                           {p: v for p, v in estado.items() if p in [PRINCIPAL] + comparten})
        except OSError as error:
            _decir("memoria compartida: no puedo apuntar lo visto (%s)" % type(error).__name__)
        return {"ok": True, "copiados": hecho["copiados"], "saltados": len(hecho["saltados"])}


# MARK: El socket


def par_del_vigia(conexion, uid_vigia: int | None = None) -> bool:
    """Si al otro lado del socket está root o el vigía, según el núcleo (``SO_PEERCRED``). Sin eso, nadie."""
    try:
        if uid_vigia is None:
            uid_vigia = pwd.getpwnam(USUARIO_VIGIA).pw_uid
        credenciales = conexion.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", credenciales)
    except (OSError, KeyError, AttributeError, TypeError, struct.error):
        return False
    return uid in (0, uid_vigia)


def par_del_mismo_usuario(conexion, uid_propio: int | None = None) -> bool:
    """Con ``--usuario``: solo este mismo usuario (el vigía sin root corre como él). Ni root ni nadie más."""
    try:
        if uid_propio is None:
            uid_propio = os.geteuid()
        credenciales = conexion.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", credenciales)
    except (OSError, AttributeError, TypeError, struct.error):
        return False
    return uid_propio != 0 and uid == uid_propio


def leer_peticion(conexion, plazo: float = 30.0) -> dict:
    conexion.settimeout(plazo)
    recibido = bytearray()
    while b"\n" not in recibido:
        if len(recibido) > MAX_LINEA:
            raise Rechazo(400, "peticion_invalida", "La petición es demasiado grande")
        trozo = conexion.recv(MAX_LINEA + 1)
        if not trozo:
            raise Rechazo(400, "peticion_invalida", "La petición llegó cortada")
        recibido += trozo
    linea, _, resto = bytes(recibido).partition(b"\n")
    if len(linea) > MAX_LINEA:
        raise Rechazo(400, "peticion_invalida", "La petición es demasiado grande")
    if resto:
        raise Rechazo(400, "peticion_invalida", "Sobran bytes")
    try:
        peticion = json.loads(linea.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Rechazo(400, "peticion_invalida", "La petición no es JSON") from None
    if not isinstance(peticion, dict):
        raise Rechazo(400, "orden_desconocida", "Orden desconocida")
    return peticion


def atender(conexion, ayudante_de, par_permitido=par_del_vigia):
    """Una conexión: la petición y la respuesta. Devuelve la continuación de un trabajo (o None), que se ejecuta con la
    conexión ya cerrada. ``ayudante_de()`` crea el ``Ayudante`` solo si el par es de fiar."""
    seguir = None
    try:
        if not par_permitido(conexion):
            raise Rechazo(403, "no_autorizado", "Este ayudante solo atiende al vigía")
        respuesta, seguir = ayudante_de().orden(leer_peticion(conexion))
    except Rechazo as rechazo:
        respuesta = rechazo.respuesta()
        if rechazo.codigo not in ("en_curso", "trabajo_desconocido"):
            _decir("rechazo: %s %s" % (rechazo.http, rechazo.codigo))
    except Exception as error:  # noqa: BLE001 — la orden falla, el ayudante contesta
        _decir("error inesperado: %s" % type(error).__name__)
        respuesta = Rechazo(500, "error", "Error interno del ayudante").respuesta()
    try:
        conexion.settimeout(30)
        conexion.sendall(json.dumps(respuesta, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
                         .encode("utf-8") + b"\n")
    except OSError:
        pass
    return seguir


USO = ("uso: hehermes-agentes [--hermes-home=<carpeta>] [--usuario-hermes=<usuario>] [--trabajo=<carpeta>] "
       "[--claves-pasarela=<carpeta>] [--claves-vigia=<carpeta>] [--copias=<carpeta>] [--unidad-hermes=<unidad>] "
       "[--puerto-hermes=<n>] [--hermes=<ruta>] [--usuario] --conexion | listar | sincronizar-memoria\n")
OPCIONES = {"hermes-home", "usuario-hermes", "trabajo", "claves-pasarela", "claves-vigia", "copias", "unidad-hermes",
            "puerto-hermes", "hermes"}
CARPETAS = ("hermes-home", "trabajo", "claves-pasarela", "claves-vigia", "copias", "hermes")


def main(argv: list) -> int:
    opciones, resto = {}, []
    for argumento in argv:
        if argumento.startswith("--") and "=" in argumento:
            clave, _, valor = argumento[2:].partition("=")
            opciones[clave] = valor
        else:
            resto.append(argumento)
    if set(opciones) - OPCIONES:
        sys.stderr.write(USO)
        return 2
    for nombre in CARPETAS:
        if nombre in opciones and (not opciones[nombre].startswith("/") or opciones[nombre].rstrip("/") == ""):
            sys.stderr.write("hehermes-agentes: --%s tiene que ser una ruta absoluta\n" % nombre)
            return 2
    try:
        puerto = int(opciones["puerto-hermes"]) if "puerto-hermes" in opciones else None
    except ValueError:
        puerto = 0
    if puerto is not None and not 0 < puerto < 65536:
        sys.stderr.write("hehermes-agentes: --puerto-hermes no vale\n")
        return 2
    unidad = opciones.get("unidad-hermes", "hermes-gateway.service")
    if not re.fullmatch(r"[A-Za-z0-9:_.@-]{1,200}\.service", unidad):
        sys.stderr.write("hehermes-agentes: --unidad-hermes no vale\n")
        return 2
    usuario = "--usuario" in resto
    if usuario and os.geteuid() == 0:
        sys.stderr.write("hehermes-agentes: --usuario es para el ayudante sin root\n")
        return 2
    resto = [r for r in resto if r != "--usuario"]
    if resto not in (["--conexion"], ["listar"], ["sincronizar-memoria"]):
        sys.stderr.write(USO)
        return 2
    usuario_hermes = opciones.get("usuario-hermes") or ("root" if os.geteuid() == 0 else
                                                        pwd.getpwuid(os.geteuid()).pw_name)
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", usuario_hermes):
        sys.stderr.write("hehermes-agentes: --usuario-hermes no vale\n")
        return 2
    config = Config(casa=opciones.get("hermes-home", "/root/.hermes"), usuario_hermes=usuario_hermes,
                    trabajo=opciones.get("trabajo", "/var/lib/hehermes-agentes"),
                    claves_pasarela=opciones.get("claves-pasarela", "/etc/hehermes-pasarela/agentes"),
                    claves_vigia=opciones.get("claves-vigia", "/etc/hehermes-avisos/agentes"),
                    copias=opciones.get("copias"), unidad=unidad, puerto=puerto, hermes=opciones.get("hermes"),
                    usuario=usuario)
    os.umask(0o077)
    if resto == ["--conexion"]:
        conexion = socket.socket(fileno=0)
        try:
            seguir = atender(conexion, lambda: Ayudante(config), par_del_mismo_usuario if usuario else par_del_vigia)
            try:
                conexion.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
        finally:
            conexion.detach()
        for fd in (0, 1):
            try:
                os.close(fd)
            except OSError:
                pass
        if seguir is not None:
            seguir()
        return 0
    try:
        if resto == ["listar"]:
            respuesta = Ayudante(config).listar()
        else:
            respuesta = Ayudante(config).sincronizar_memoria()
    except Rechazo as rechazo:
        sys.stderr.write("hehermes-agentes: %d %s: %s\n" % (rechazo.http, rechazo.codigo, rechazo.mensaje))
        return 1
    print(json.dumps(respuesta, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
