class Rechazo(Exception):
    def __init__(self, http_: int, codigo: str, mensaje: str):
        super().__init__(mensaje)
        self.http, self.codigo, self.mensaje = http_, codigo, mensaje

    def respuesta(self) -> dict:
        return {"ok": False, "http": self.http, "codigo": self.codigo, "mensaje": self.mensaje}


class Fallo(Exception):
    """Un trabajo que no sigue, con su motivo (uno de `MOTIVOS`)."""

    def __init__(self, motivo: str):
        super().__init__(motivo)
        self.motivo = motivo


def _decir(texto: str) -> None:
    """El registro: el perfil, el principio del id, la orden y el resultado. Nunca una clave ni un contenido."""
    sys.stderr.write("hehermes-agentes: %s\n" % texto)
    sys.stderr.flush()


def _invalido(que: str) -> Rechazo:
    return Rechazo(400, "parametro_invalido", que)


# MARK: Lo que llega


def _texto(valor, maximo: int, lineas: bool, vacio: bool, que: str) -> str:
    """Un texto de la app: hasta `maximo` bytes en UTF-8, sin caracteres de control (salvo los saltos de línea y los
    tabuladores, si van en `lineas`) y, si no puede ir `vacio`, con algo más que espacios."""
    if not isinstance(valor, str):
        raise _invalido("«%s» tiene que ser un texto" % que)
    try:
        largo = len(valor.encode("utf-8"))
    except UnicodeEncodeError:
        raise _invalido("«%s» no es UTF-8" % que) from None
    if largo > maximo:
        raise _invalido("«%s» pasa de %d bytes" % (que, maximo))
    for caracter in valor:
        categoria = unicodedata.category(caracter)
        if categoria in ("Cc", "Cs", "Zl", "Zp") and not (lineas and caracter in "\n\r\t"):
            raise _invalido("«%s» lleva caracteres de control" % que)
    if not vacio and not valor.strip():
        raise _invalido("«%s» no puede ir vacío" % que)
    return valor


def validar_nombre(valor) -> str:
    nombre = _texto(valor, 4 * MAX_NOMBRE, lineas=False, vacio=False, que="nombre").strip()
    if len(nombre) > MAX_NOMBRE:
        raise _invalido("«nombre» pasa de %d caracteres" % MAX_NOMBRE)
    return nombre


def validar_de_la_lista(valor, lista, que: str) -> str:
    if valor not in lista:
        raise _invalido("«%s» tiene que ser uno de: %s" % (que, ", ".join(lista)))
    return valor


def validar_descripcion(valor) -> str:
    """Una frase: sin saltos de línea, y sin un «-» al principio (va de argumento a `hermes profile describe`)."""
    descripcion = _texto(valor, MAX_TEXTO, lineas=False, vacio=True, que="descripcion").strip()
    if descripcion.startswith("-"):
        raise _invalido("«descripcion» no puede empezar por «-»")
    return descripcion


def validar_personalidad(valor) -> str:
    return _texto(valor, MAX_TEXTO, lineas=True, vacio=False, que="personalidad")


def validar_perfil(valor) -> str:
    if not isinstance(valor, str) or not PATRON_PERFIL.fullmatch(valor):
        raise _invalido("El perfil son de 1 a 24 minúsculas y cifras")
    return valor


def validar_id(valor) -> str:
    if not isinstance(valor, str) or not PATRON_ID.fullmatch(valor):
        raise _invalido("El id de un trabajo son 32 hexadecimales")
    return valor


def es_un_modelo(valor) -> bool:
    """Si un id de modelo tiene su forma y en el YAML sería un texto."""
    return isinstance(valor, str) and PATRON_MODELO.fullmatch(valor) is not None and \
        OTRO_TIPO_EN_YAML.fullmatch(valor) is None


def es_un_proveedor(valor) -> bool:
    return isinstance(valor, str) and PATRON_PROVEEDOR.fullmatch(valor) is not None and \
        OTRO_TIPO_EN_YAML.fullmatch(valor) is None


def validar_modelo(valor) -> dict | None:
    """`null` (el del principal) o `{"proveedor", "modelo"}`, cada uno con su forma. Si Hermes lo ofrece se mira
    después (`Ayudante._comprobar_modelo`)."""
    if valor is None:
        return None
    if not isinstance(valor, dict) or set(valor) != {"proveedor", "modelo"}:
        raise _invalido("«modelo» es null o {\"proveedor\", \"modelo\"}")
    if not es_un_proveedor(valor["proveedor"]) or not es_un_modelo(valor["modelo"]):
        raise _invalido("«modelo» no tiene la forma de un modelo de Hermes")
    return {"proveedor": valor["proveedor"], "modelo": valor["modelo"]}


def validar_creacion(peticion: dict) -> dict:
    return {"nombre": validar_nombre(peticion.get("nombre")),
            "color": validar_de_la_lista(peticion.get("color"), COLORES, "color"),
            "expresion": validar_de_la_lista(peticion.get("expresion"), EXPRESIONES, "expresion"),
            "descripcion": validar_descripcion(peticion.get("descripcion")),
            "personalidad": validar_personalidad(peticion.get("personalidad")),
            "memoria": validar_de_la_lista(peticion.get("memoria"), MEMORIAS, "memoria"),
            "modelo": validar_modelo(peticion.get("modelo"))}


def validar_cambios(peticion: dict) -> dict:
    """Lo que cambia, con su forma: al menos una cosa. El modelo va solo (es un trabajo, §18.11)."""
    if "modelo" in peticion:
        if set(peticion) - {"orden", "perfil", "modelo"}:
            raise _invalido("«modelo» se cambia solo")
        return {"modelo": validar_modelo(peticion["modelo"])}
    validar = {"nombre": validar_nombre, "descripcion": validar_descripcion, "personalidad": validar_personalidad,
               "color": lambda v: validar_de_la_lista(v, COLORES, "color"),
               "expresion": lambda v: validar_de_la_lista(v, EXPRESIONES, "expresion")}
    cambios = {campo: validar[campo](peticion[campo]) for campo in CAMBIABLES if campo in peticion}
    if not cambios:
        raise _invalido("No hay nada que cambiar")
    return cambios


def perfil_de(nombre: str, ocupados) -> str:
    """El perfil que sale de un nombre (contrato §18.3): en minúsculas, sin tildes, solo letras latinas y cifras, hasta
    24; `agente` si no queda nada; y si ya está (o es el del principal, o una ruta del vigía), con un número detrás."""
    plano = unicodedata.normalize("NFKD", nombre).lower()
    base = "".join(c for c in plano if c in "abcdefghijklmnopqrstuvwxyz0123456789")[:24] or "agente"
    ocupados = set(ocupados) | RESERVADOS
    if base not in ocupados:
        return base
    numero = 2
    while True:
        sufijo = str(numero)
        candidato = base[:24 - len(sufijo)] + sufijo
        if candidato not in ocupados:
            return candidato
        numero += 1


def clave_nueva() -> str:
    """32 bytes del generador del sistema, en base64url sin relleno: lo mismo que los tokens de la pasarela."""
    return base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode("ascii")


# MARK: El SOUL.md


#: El párrafo que le dice a un agente cómo mandar ficheros al iPhone: el del instalador para el principal
#: (`hehermes_servidor.alma`, una prueba los ata), con la carpeta `exports` de su perfil.
TITULO_FICHEROS = "## Ficheros para el iPhone (HeHermes)"


def parrafo_de_ficheros(carpeta: str) -> str:
    return ("%s\n\nCuando quieras mandarme un fichero al iPhone (un PDF, una imagen, un informe…), guárdalo como un "
            "fichero normal (no un enlace ni una carpeta) en %s y, en tu respuesta, pon una línea aparte con MEDIA: y "
            "su ruta absoluta; por ejemplo, MEDIA:%s/informe.pdf. La app HeHermes solo descarga lo que está en esa "
            "carpeta.\n" % (TITULO_FICHEROS, carpeta, carpeta))


def alma_de(personalidad: str, exportaciones: str) -> str:
    return personalidad.rstrip("\n") + "\n\n" + parrafo_de_ficheros(exportaciones)


def personalidad_de(alma: str) -> str:
    """Lo que escribió la app, sin el párrafo de los ficheros: lo que se enseña para editar."""
    principio = alma.find(TITULO_FICHEROS)
    texto = alma if principio < 0 else alma[:principio]
    return texto.rstrip("\n")[:MAX_TEXTO]


# MARK: Descriptores, sin seguir enlaces


def _cerrar(*fds) -> None:
    for fd in fds:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def _abrir_carpeta(nombre: str, dentro: int) -> int:
    return os.open(nombre, _CARPETA, dir_fd=dentro)


def _abrir_o_crear_carpeta(nombre: str, dentro: int, modo: int = 0o700) -> int:
    try:
        os.mkdir(nombre, modo, dir_fd=dentro)
    except FileExistsError:
        pass
    return _abrir_carpeta(nombre, dentro)


def abrir_casa(casa: str, perfil: str) -> int:
    """La casa de un perfil, abierta: la del principal es la de Hermes (que sí puede ser un enlace: la da la unidad);
    la de otro, `profiles/<perfil>` dentro, sin seguir enlaces."""
    raiz = os.open(casa, os.O_RDONLY | os.O_DIRECTORY | _CLOEXEC)
    if perfil == PRINCIPAL:
        return raiz
    perfiles = None
    try:
        perfiles = _abrir_carpeta("profiles", raiz)
        return _abrir_carpeta(perfil, perfiles)
    finally:
        _cerrar(perfiles, raiz)


def _leer(carpeta: int, nombre: str, tope: int = 1024 * 1024) -> bytes | None:
    """Un fichero normal de `carpeta`, sin seguir enlaces, o None si no está. Un enlace es un `OSError` (ELOOP)."""
    try:
        fd = os.open(nombre, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | _CLOEXEC, dir_fd=carpeta)
    except FileNotFoundError:
        return None
    try:
        visto = os.fstat(fd)
        if not stat.S_ISREG(visto.st_mode) or visto.st_size > tope:
            raise OSError(errno.EINVAL, "no es un fichero normal o es demasiado grande")
        partes = []
        while True:
            trozo = os.read(fd, 65536)
            if not trozo:
                break
            partes.append(trozo)
        return b"".join(partes)
    finally:
        os.close(fd)


def _escribir_todo(fd: int, datos: bytes) -> None:
    vista = memoryview(datos)
    while vista:
        escritos = os.write(fd, vista)
        vista = vista[escritos:]


def _escribir(carpeta: int, nombre: str, datos: bytes, modo: int = 0o600, mtime_ns: int | None = None) -> None:
    """Al lado y renombrado: o queda el nuevo entero, o el de antes. Sin seguir enlaces (un enlace con ese nombre se
    sustituye, no se sigue). Con `mtime_ns`, con esa hora (la copia de una memoria lleva la de su original)."""
    temporal = ".%s.%s.hehermes" % (nombre, secrets.token_hex(4))
    fd = os.open(temporal, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | _CLOEXEC, modo, dir_fd=carpeta)
    try:
        try:
            os.fchmod(fd, modo)
            _escribir_todo(fd, datos)
            if mtime_ns is not None:
                os.utime(fd, ns=(mtime_ns, mtime_ns))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(temporal, nombre, src_dir_fd=carpeta, dst_dir_fd=carpeta)
    except BaseException:
        try:
            os.unlink(temporal, dir_fd=carpeta)
        except OSError:
            pass
        raise


def _quitar(carpeta: int, nombre: str) -> None:
    """Un fichero (o un enlace, que se quita sin seguirlo), si está."""
    try:
        if not stat.S_ISDIR(os.stat(nombre, dir_fd=carpeta, follow_symlinks=False).st_mode):
            os.unlink(nombre, dir_fd=carpeta)
    except FileNotFoundError:
        pass


@contextlib.contextmanager
def flock_de_hermes(carpeta: int, espera: float):
    """El flock exclusivo de `USER.md.lock`, el que toma Hermes al escribir su memoria (`_file_lock`, que también
    abre el `.lock` sin seguir enlaces). True si se ha tomado en `espera` segundos; False si no (y no se tiene)."""
    fd = os.open(CERROJO_DE_USER, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | _CLOEXEC, 0o600, dir_fd=carpeta)
    try:
        limite = time.monotonic() + espera
        tomado = False
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                tomado = True
                break
            except OSError as error:
                if error.errno not in (errno.EWOULDBLOCK, errno.EAGAIN, errno.EACCES):
                    raise
            if time.monotonic() >= limite:
                break
            time.sleep(0.05)
        try:
            yield tomado
        finally:
            if tomado:
                fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


# MARK: La casa de cada perfil (lo que corre como el dueño de Hermes, `Sistema.como_hermes`)


def _carpeta_de_perfiles(casa: str) -> tuple:
    """`(casa, profiles)` abiertas, o `(None, None)` si no hay."""
    try:
        raiz = os.open(casa, os.O_RDONLY | os.O_DIRECTORY | _CLOEXEC)
    except OSError:
        return None, None
    try:
        return raiz, _abrir_carpeta("profiles", raiz)
    except OSError:
        os.close(raiz)
        return None, None


def nombres_en_profiles(casa: str) -> list:
    """Todo lo que hay en `<casa>/profiles`, sea lo que sea: para no repetir un nombre al crear."""
    raiz, perfiles = _carpeta_de_perfiles(casa)
    if perfiles is None:
        return []
    try:
        return sorted(os.listdir(perfiles))
    finally:
        _cerrar(perfiles, raiz)


def _hay(nombre: str, dentro: int) -> bool:
    """Si hay algo con ese nombre (sin seguirlo, si es un enlace)."""
    try:
        os.stat(nombre, dir_fd=dentro, follow_symlinks=False)
        return True
    except OSError:
        return False


def _es_marca(carpeta: int, nombre: str) -> bool:
    """Lo que Hermes toma por una marca de perfil: un fichero normal, o un enlace aunque no lleve a nada."""
    try:
        modo = os.stat(nombre, dir_fd=carpeta, follow_symlinks=False).st_mode
    except OSError:
        return False
    return stat.S_ISREG(modo) or stat.S_ISLNK(modo)


def _valor_yaml(texto: str) -> str | None:
    """Un valor de una línea de YAML, sin comillas; None si es nulo (vacío, `~` o `null`)."""
    valor = texto.strip().strip("'\"")
    return None if valor in ("", "~", "null", "Null", "NULL") else valor


def _valores_del_config(texto: str, clave: str) -> tuple:
    """`(arriba, en gateway)`: el último valor de `clave` en el primer nivel de un config.yaml, y en el primer nivel de su
    bloque `gateway:` de arriba (o en `gateway: {…}`); None donde no está. Hermes lo lee con YAML; aquí, sin dependencias,
    lo justo."""
    arriba = en_gateway = None
    dentro, nivel = False, None
    propia = re.compile(r"\s*%s\s*:\s*(.*)" % re.escape(clave))
    for linea in texto.splitlines():
        limpia = re.sub(r"\s+#.*$", "", linea).rstrip()
        if not limpia.strip() or limpia.lstrip().startswith("#"):
            continue
        sangria = len(limpia) - len(limpia.lstrip())
        if sangria == 0:
            bloque = re.fullmatch(r"gateway\s*:\s*(.*)", limpia)
            dentro, nivel = bloque is not None and bloque.group(1) == "", None
            if bloque and bloque.group(1).startswith("{"):
                en_linea = re.search(r"[{,]\s*%s\s*:\s*([^,}]*)" % re.escape(clave), bloque.group(1))
                if en_linea:
                    en_gateway = _valor_yaml(en_linea.group(1))
            suya = propia.fullmatch(limpia)
            if suya:
                arriba = _valor_yaml(suya.group(1))
            continue
        if not dentro:
            continue
        nivel = sangria if nivel is None else nivel
        suya = propia.fullmatch(limpia)
        if sangria == nivel and suya:
            en_gateway = _valor_yaml(suya.group(1))
    return arriba, en_gateway


def _es_un_si(valor: str | None) -> bool:
    return valor is not None and SI_EN_YAML.fullmatch(valor) is not None


def config_independiente(texto: str) -> bool:
    """Si un config.yaml dice `gateway.standalone: true` (el perfil tiene su propia pasarela y Hermes no lo sirve): la
    clave `standalone` en el bloque `gateway:`, con un valor que YAML da por verdadero."""
    return _es_un_si(_valores_del_config(texto, "standalone")[1])


def config_multiplexa(texto: str) -> bool:
    """Si el config.yaml del principal le dice a Hermes que sirva todos los perfiles, como lo lee él
    (`explicit_multiplex_flag`): el alias de arriba, `multiplex_profiles`, si está; si no, `gateway.multiplex_profiles`."""
    arriba, en_gateway = _valores_del_config(texto, "multiplex_profiles")
    return _es_un_si(arriba if arriba is not None else en_gateway)


def bloque_del_modelo(texto: str) -> dict:
    """Las claves de primer nivel del `model:` de arriba de un config.yaml (el último, como YAML), con sus valores de
    una línea, sin comillas: `{"default", "provider", "base_url"…}`. `model: <id>` a secas es `{"default": <id>}` (la
    forma corta, que Hermes también lee), y `model: {…}` en una línea, lo justo. Vacío si no hay. Hermes lo lee con
    YAML; aquí, sin dependencias, lo que escribe su `config set` (un bloque con sangría). Lo que va más hondo, o es
    nulo, no está."""
    bloque, dentro, nivel = {}, False, None
    for linea in texto.splitlines():
        limpia = re.sub(r"\s+#.*$", "", linea).rstrip()
        if not limpia.strip() or limpia.lstrip().startswith("#"):
            continue
        sangria = len(limpia) - len(limpia.lstrip())
        if sangria == 0:
            suya = re.fullmatch(r"model\s*:(.*)", limpia)
            dentro = False
            if suya is None:
                continue
            valor = suya.group(1).strip()
            bloque, nivel, dentro = {}, None, not valor
            if valor.startswith("{") and valor.endswith("}"):
                for trozo in valor[1:-1].split(","):
                    clave, dos, resto = trozo.partition(":")
                    if dos and re.fullmatch(r"\s*[A-Za-z_][A-Za-z0-9_]*\s*", clave):
                        bloque[clave.strip()] = _valor_yaml(resto)
            elif valor:
                bloque = {"default": _valor_yaml(valor)}
            continue
        if not dentro:
            continue
        nivel = sangria if nivel is None else nivel
        suya = re.fullmatch(r"\s*([A-Za-z_][A-Za-z0-9_]*)\s*:(.*)", limpia)
        if sangria == nivel and suya:
            bloque[suya.group(1)] = _valor_yaml(suya.group(2))
    return {clave: valor for clave, valor in bloque.items() if valor is not None}


def modelo_de(bloque: dict) -> dict | None:
    """El modelo de un perfil para la app (§18.2): su id y su proveedor, si tienen su forma. Nunca su ruta ni su
    clave."""
    modelo = bloque.get("default") or bloque.get("model")
    if not es_un_modelo(modelo):
        return None
    proveedor = bloque.get("provider")
    return {"proveedor": proveedor if es_un_proveedor(proveedor) else None, "modelo": modelo}


def leer_config(casa: str, perfil: str) -> str | None:
    """El config.yaml de un perfil tal cual, en base64 (pasa por la tubería de `como_hermes`); None si no tiene."""
    carpeta = abrir_casa(casa, perfil)
    try:
        datos = _leer(carpeta, CONFIG)
    finally:
        os.close(carpeta)
    return None if datos is None else base64.b64encode(datos).decode("ascii")


def devolver_config(casa: str, perfil: str, guardado: str) -> None:
    """El config.yaml de antes, byte a byte y 0600 (como lo deja Hermes): lo que deshace un cambio de modelo a
    medias."""
    carpeta = abrir_casa(casa, perfil)
    try:
        _escribir(carpeta, CONFIG, base64.b64decode(guardado))
    finally:
        os.close(carpeta)


def texto_de(guardado: str | None) -> str:
    return "" if guardado is None else base64.b64decode(guardado).decode("utf-8", "replace")


def opciones_de_hermes(datos: bytes) -> dict | None:
    """`/api/model/options` con la regla de `/model` (la misma de la app, `OpcionesServidor`): de cada proveedor
    autenticado, no virtual y con algún modelo que se pueda usar, sus nombres (su `slug` y sus `aliases`) y esos
    modelos. None si no es eso."""
    try:
        raiz = json.loads(datos.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(raiz, dict) or not isinstance(raiz.get("providers"), list):
        return None
    proveedores = []
    for fila in raiz["providers"]:
        if not isinstance(fila, dict) or fila.get("authenticated") is not True or fila.get("source") == "virtual" \
                or not es_un_proveedor(fila.get("slug")):
            continue
        fuera = set()
        for dato in fila.get("unavailable_models") if isinstance(fila.get("unavailable_models"), list) else ():
            # Su id suelto, o un objeto con él en `id`, `model` o `name`.
            ids = [dato] if isinstance(dato, str) else [dato.get(k) for k in ("id", "model", "name")] \
                if isinstance(dato, dict) else []
            fuera.update([i for i in ids if isinstance(i, str)][:1])
        modelos = {m for m in fila.get("models") if isinstance(m, str) and m and m not in fuera} \
            if isinstance(fila.get("models"), list) else set()
        if not modelos:
            continue
        alias = [n for n in fila.get("aliases") if isinstance(n, str)] if isinstance(fila.get("aliases"), list) else []
        proveedores.append({"slug": fila["slug"], "nombres": [fila["slug"]] + alias, "modelos": modelos})
    return {"proveedores": proveedores}


def pasos_del_modelo(actual: dict, principal: dict, proveedor: str | None, modelo: str) -> tuple:
    """`(pasos, objetivo)`: lo que hay que hacer en el `model:` de un perfil (`actual`) para que quede con `proveedor` y
    `modelo`, y cómo tiene que quedar. Los pasos son `("unset", clave)` y `("set", clave, valor)`, en este orden: lo que
    se va, antes de cambiar el proveedor (así el `config set model.provider` de Hermes no encuentra ruta vieja que
    dejar); luego el proveedor, el id y la ruta que haya que copiar. Lo que hace un `/model` persistido
    (`model_selection_config_updates`): con el mismo proveedor, su ruta se queda; con otro, se va —la del nuevo la
    resuelve Hermes—, salvo si vuelve al del principal, que se copia del suyo (nunca su clave). `Fallo("modelo")` si así
    no se puede: uno que se configura por su dirección, o el del principal con su clave en su config.yaml."""
    mismo = actual.get("provider") == proveedor
    if mismo:
        ruta = {k: actual[k] for k in RUTA_DEL_MODELO + SECRETOS_DEL_MODELO if k in actual}
    elif proveedor is not None and proveedor == principal.get("provider"):
        if any(k in principal for k in SECRETOS_DEL_MODELO):
            raise Fallo("modelo")
        ruta = {k: principal[k] for k in RUTA_DEL_MODELO if k in principal}
        if not all(PATRON_RUTA[k].fullmatch(v) for k, v in ruta.items()):
            raise Fallo("modelo")
    elif proveedor is not None and proveedor.lower() in PROVEEDORES_POR_DIRECCION:
        raise Fallo("modelo")
    else:
        ruta = {}
    objetivo = dict(ruta, default=modelo)
    if proveedor is not None:
        objetivo["provider"] = proveedor
    if mismo and (actual.get("default") or actual.get("model")) == modelo:
        objetivo.update({k: actual[k] for k in FIJADO_AL_MODELO if k in actual})
    pasos = [("unset", k) for k in ("model", "provider") + RUTA_DEL_MODELO + SECRETOS_DEL_MODELO + FIJADO_AL_MODELO
             if k in actual and k not in objetivo]
    if proveedor is not None and actual.get("provider") != proveedor:
        pasos.append(("set", "provider", proveedor))
    if actual.get("default") != modelo:
        pasos.append(("set", "default", modelo))
    pasos += [("set", k, v) for k, v in ruta.items() if k in RUTA_DEL_MODELO and actual.get(k) != v]
    return pasos, objetivo


def queda_como(bloque: dict, objetivo: dict) -> bool:
    """Si el `model:` ha quedado como se quería: lo de `objetivo`, y nada más de lo que mueve un cambio de modelo."""
    claves = ("default", "model", "provider") + RUTA_DEL_MODELO + SECRETOS_DEL_MODELO + FIJADO_AL_MODELO
    return all(bloque.get(k) == objetivo.get(k) for k in claves)


def perfiles_de_hermes(casa: str) -> list:
    """Los perfiles de `<casa>/profiles` que Hermes serviría (`profiles_to_serve` de la 0.21.5), sin lanzar `hermes`:
    carpetas de verdad (no enlaces) con nombre de perfil (el de §18, que cabe en el suyo) y sin `default`, con alguna de
    sus marcas, sin lápida, sin aparcar y sin `gateway.standalone`."""
    raiz, perfiles = _carpeta_de_perfiles(casa)
    if perfiles is None:
        return []
    try:
        nombres = []
        for nombre in sorted(os.listdir(perfiles)):
            if not PATRON_PERFIL.fullmatch(nombre) or nombre == PRINCIPAL or _hay(LAPIDAS + "/" + nombre, perfiles):
                continue
            try:
                carpeta = _abrir_carpeta(nombre, perfiles)
            except OSError:
                continue
            try:
                if not any(_es_marca(carpeta, marca) for marca in MARCAS_DE_PERFIL) or _hay(APARCADO, carpeta):
                    continue
                try:
                    config = (_leer(carpeta, CONFIG, 256 * 1024) or b"").decode("utf-8", "replace")
                except OSError:
                    config = ""
                if not config_independiente(config):
                    nombres.append(nombre)
            finally:
                os.close(carpeta)
        return nombres
    finally:
        _cerrar(perfiles, raiz)


def leer_ficha(carpeta: int) -> dict:
    """La ficha de un perfil, con lo que tenga su forma; lo demás no está."""
    try:
        datos = json.loads((_leer(carpeta, FICHA, 64 * 1024) or b"{}").decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}
    if not isinstance(datos, dict):
        return {}
    ficha = {}
    for campo, valido in (("nombre", validar_nombre), ("descripcion", validar_descripcion),
                          ("color", lambda v: validar_de_la_lista(v, COLORES, "color")),
                          ("expresion", lambda v: validar_de_la_lista(v, EXPRESIONES, "expresion")),
                          ("memoria", lambda v: validar_de_la_lista(v, MEMORIAS, "memoria"))):
        try:
            ficha[campo] = valido(datos.get(campo))
        except Rechazo:
            continue
    return ficha


def clave_del_env(texto: bytes | None) -> str | None:
    """La `API_SERVER_KEY` de un .env (la última, como la lee Hermes), o None."""
    clave = None
    for linea in (texto or b"").decode("utf-8", "replace").splitlines():
        if PATRON_CLAVE_ENV.match(linea):
            clave = linea.split("=", 1)[1].strip().strip("'\"")
    return clave if clave and PATRON_CLAVE.fullmatch(clave) and '"' not in clave else None


def leer_perfiles(casa: str, perfiles: list, alma: bool = False, preparar: bool = False) -> dict:
    """De cada perfil (y del principal): su ficha, la clave de su .env y su modelo (`modelo_de`); con `alma`, su
    SOUL.md; con `preparar`, le crea las carpetas para el iPhone que le falten (las de un perfil que ya estaba)."""
    leidos = {}
    for perfil in [PRINCIPAL] + [p for p in perfiles if p != PRINCIPAL]:
        try:
            carpeta = abrir_casa(casa, perfil)
        except OSError:
            continue
        try:
            datos = {"ficha": leer_ficha(carpeta), "clave": None, "alma": None, "modelo": None}
            try:
                datos["clave"] = clave_del_env(_leer(carpeta, ENV))
            except OSError:
                pass
            try:
                datos["modelo"] = modelo_de(bloque_del_modelo((_leer(carpeta, CONFIG, 256 * 1024) or b"")
                                                              .decode("utf-8", "replace")))
            except OSError:
                pass
            if alma:
                try:
                    datos["alma"] = (_leer(carpeta, ALMA, 4 * MAX_TEXTO) or b"").decode("utf-8", "replace")
                except OSError:
                    datos["alma"] = ""
            if preparar and perfil != PRINCIPAL:
                for nombre in CARPETAS_DEL_IPHONE:
                    try:
                        os.mkdir(nombre, 0o700, dir_fd=carpeta)
                    except OSError:
                        pass
            leidos[perfil] = datos
        finally:
            os.close(carpeta)
    return leidos


def ficha_nueva(datos: dict, creado: int) -> bytes:
    ficha = {"v": 1, "nombre": datos["nombre"], "color": datos["color"], "expresion": datos["expresion"],
             "descripcion": datos["descripcion"], "memoria": datos["memoria"], "creado": creado}
    return json.dumps(ficha, ensure_ascii=False, sort_keys=True, indent=1).encode("utf-8") + b"\n"


def leer_user_del_principal(casa: str, espera: float) -> tuple | None:
    """`(contenido, hora en ns)` del USER.md del principal, leído con su flock (lo que sabe de ti). None si no tiene (o
    es un enlace)."""
    raiz = memoria = None
    try:
        raiz = abrir_casa(casa, PRINCIPAL)
        try:
            memoria = _abrir_carpeta(CARPETA_MEMORIA, raiz)
        except FileNotFoundError:
            return None
        with flock_de_hermes(memoria, espera) as tomado:
            if not tomado:
                raise Fallo("memoria")
            visto = _mirar_user(memoria)
            try:
                datos = _leer(memoria, USER)
            except OSError:
                return None
            return None if datos is None or not isinstance(visto, list) else (datos, visto[0])
    finally:
        _cerrar(memoria, raiz)


def poner_clave_del_perfil(casa: str, perfil: str, clave: str) -> None:
    """La clave nueva en el .env de un perfil recién creado (`poner_clave_en_el_env`)."""
    try:
        carpeta = abrir_casa(casa, perfil)
    except OSError:
        raise Fallo("hermes") from None
    try:
        poner_clave_en_el_env(carpeta, clave)
    except OSError:
        raise Fallo("clave") from None
    finally:
        os.close(carpeta)


def preparar_perfil(casa: str, perfil: str, datos: dict, exportaciones: str, espera: float, creado: int) -> None:
    """Lo que hace el ayudante en la casa de un perfil recién creado, tras `hermes profile create --clone` y su clave:
    su alma, su ficha, sus carpetas para el iPhone y su memoria según el modo."""
    try:
        carpeta = abrir_casa(casa, perfil)
    except OSError:
        raise Fallo("hermes") from None
    memoria = None
    try:
        try:
            _escribir(carpeta, ALMA, alma_de(datos["personalidad"], exportaciones).encode("utf-8"))
            _escribir(carpeta, FICHA, ficha_nueva(datos, creado))
            for nombre in CARPETAS_DEL_IPHONE:
                dentro = _abrir_o_crear_carpeta(nombre, carpeta)
                try:
                    os.fchmod(dentro, 0o700)
                finally:
                    os.close(dentro)
        except OSError:
            raise Fallo("interna") from None
        try:
            memoria = _abrir_o_crear_carpeta(CARPETA_MEMORIA, carpeta)
            # Lo de su trabajo es siempre suyo: empieza sin nada, lo que traiga el clon.
            for nombre in (USER, TRABAJO_DE_HERMES):
                _quitar(memoria, nombre)
            if datos["memoria"] != "cero":
                lo_que_sabe = leer_user_del_principal(casa, espera)
                if lo_que_sabe is not None:
                    with flock_de_hermes(memoria, espera) as tomado:
                        if not tomado:
                            raise Fallo("memoria")
                        # Con la hora del original: una copia no es «lo más nuevo» para la memoria compartida.
                        _escribir(memoria, USER, lo_que_sabe[0], mtime_ns=lo_que_sabe[1])
        except OSError:
            raise Fallo("memoria") from None
    finally:
        _cerrar(memoria, carpeta)


def poner_clave_en_el_env(carpeta: int, clave: str) -> None:
    """La clave nueva en el .env del perfil, una sola vez: fuera las que trajera el clon (la del principal)."""
    antes = _leer(carpeta, ENV) or b""
    quedan = [linea for linea in antes.decode("utf-8", "surrogateescape").splitlines()
              if not PATRON_CLAVE_ENV.match(linea)]
    nuevo = "\n".join(quedan + ["API_SERVER_KEY=" + clave]) + "\n"
    _escribir(carpeta, ENV, nuevo.encode("utf-8", "surrogateescape"))


def cambiar_perfil(casa: str, perfil: str, cambios: dict, exportaciones: str) -> None:
    carpeta = abrir_casa(casa, perfil)
    try:
        en_la_ficha = {k: v for k, v in cambios.items() if k != "personalidad"}
        if en_la_ficha:
            try:
                bruta = json.loads((_leer(carpeta, FICHA, 64 * 1024) or b"{}").decode("utf-8"))
            except (OSError, ValueError, UnicodeDecodeError):
                bruta = {}
            ficha = dict(bruta) if isinstance(bruta, dict) else {}
            ficha.update(en_la_ficha, v=1)
            _escribir(carpeta, FICHA, json.dumps(ficha, ensure_ascii=False, sort_keys=True, indent=1).encode("utf-8")
                      + b"\n")
        if "personalidad" in cambios:
            _escribir(carpeta, ALMA, alma_de(cambios["personalidad"], exportaciones).encode("utf-8"))
    finally:
        os.close(carpeta)


def preparar_copias(carpeta: str) -> list:
    """La carpeta de las copias (0700, del dueño de Hermes), y lo que ya hay en ella."""
    os.makedirs(carpeta, mode=0o700, exist_ok=True)
    os.chmod(carpeta, 0o700)
    return sorted(os.listdir(carpeta))


def copias_nuevas(carpeta: str, antes: list) -> list:
    """Lo que ha aparecido en la carpeta de las copias desde `antes`: ficheros normales y no vacíos."""
    nuevas = []
    for nombre in os.listdir(carpeta):
        if nombre in antes:
            continue
        try:
            visto = os.stat(os.path.join(carpeta, nombre), follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISREG(visto.st_mode) and visto.st_size > 0:
            nuevas.append(nombre)
    return nuevas


# MARK: La memoria que se comparte (§18.8)


def _sha(datos: bytes) -> str:
    return hashlib.sha256(datos).hexdigest()


def _mirar_user(memoria: int):
    """`[mtime en ns, sha256]` del USER.md de una carpeta `memories`, `None` si no está, o `"enlace"` si no es un
    fichero normal (un enlace no se sigue ni se toca)."""
    try:
        visto = os.stat(USER, dir_fd=memoria, follow_symlinks=False)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(visto.st_mode):
        return "enlace"
    try:
        datos = _leer(memoria, USER)
    except OSError:
        return "enlace"
    return None if datos is None else [visto.st_mtime_ns, _sha(datos)]


def _carpeta_de_memoria(casa: str, perfil: str, crear: bool = False) -> int | None:
    carpeta = None
    try:
        carpeta = abrir_casa(casa, perfil)
        return (_abrir_o_crear_carpeta if crear else _abrir_carpeta)(CARPETA_MEMORIA, carpeta)
    except OSError:
        return None
    finally:
        _cerrar(carpeta)


def sincronizar(casa: str, perfiles: list, previo: dict, espera: float) -> dict:
    """Entre el principal y los perfiles que comparten (`perfiles`): el USER.md más nuevo (por su hora) va a los demás.
    De cada uno se toma su flock; el de origen se lee con el suyo y cada destino se escribe con el suyo, de golpe y
    0600, solo si sigue como se vio (si Hermes lo ha cambiado entretanto, a la vuelta siguiente, que será el más nuevo).
    Cada copia lleva la hora de su original: así una copia nunca gana a lo que Hermes escriba después, aunque llegue
    mientras se copia. Un destino cuyo flock no llega en `espera` segundos se salta esta vuelta. `previo` es lo visto en
    la vuelta anterior (para saber cuántos cambiaron); devuelve lo de esta, para la siguiente."""
    vistos = {}
    for perfil in perfiles:
        memoria = _carpeta_de_memoria(casa, perfil)
        visto = None
        if memoria is not None:
            try:
                visto = _mirar_user(memoria)
            finally:
                os.close(memoria)
        if visto == "enlace":
            continue
        vistos[perfil] = visto
    con_algo = {p: v for p, v in vistos.items() if v}
    resultado = {"estado": {}, "copiados": 0, "saltados": [], "cambiados": [], "ganador": None}
    if not con_algo:
        return resultado
    ganador = max(con_algo, key=lambda p: (con_algo[p][0], p))
    resultado["ganador"] = ganador
    resultado["cambiados"] = sorted(p for p, v in con_algo.items() if previo.get(p) != v)
    memoria = _carpeta_de_memoria(casa, ganador)
    if memoria is None:
        return resultado
    try:
        with flock_de_hermes(memoria, espera) as tomado:
            if not tomado:
                resultado["saltados"].append(ganador)
                return resultado
            datos = _leer(memoria, USER)
            visto = _mirar_user(memoria)
    except OSError:
        return resultado
    finally:
        os.close(memoria)
    if datos is None or not isinstance(visto, list):
        return resultado
    sha = _sha(datos)
    resultado["estado"][ganador] = visto
    for perfil, antes in vistos.items():
        if perfil == ganador:
            continue
        if antes and antes[1] == sha:
            resultado["estado"][perfil] = antes
            continue
        memoria = _carpeta_de_memoria(casa, perfil, crear=True)
        if memoria is None:
            continue
        try:
            with flock_de_hermes(memoria, espera) as tomado:
                if not tomado:
                    resultado["saltados"].append(perfil)
                    continue
                if _mirar_user(memoria) != antes:
                    continue
                _escribir(memoria, USER, datos, mtime_ns=visto[0])
                ahora = _mirar_user(memoria)
                if isinstance(ahora, list):
                    resultado["estado"][perfil] = ahora
                resultado["copiados"] += 1
        except OSError:
            continue
        finally:
            os.close(memoria)
    return resultado


# MARK: Las claves para la pasarela y el vigía


def escribir_clave(carpeta: str, perfil: str, clave: str, modo: int) -> None:
    """`<carpeta>/<perfil>.clave`, al lado y renombrado, sin seguir enlaces. Del grupo de la carpeta: con root, la de la
    pasarela es `root:hh-pasarela` y la del vigía `root:hh-vigia`, con el bit setgid, así que lo nuevo nace de su
    grupo; si no lo tuviera, se le da."""
    dentro = os.open(carpeta, os.O_RDONLY | os.O_DIRECTORY | _CLOEXEC)
    temporal = ".%s.clave.%s" % (perfil, secrets.token_hex(4))
    try:
        grupo = os.fstat(dentro).st_gid
        fd = os.open(temporal, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | _CLOEXEC, modo, dir_fd=dentro)
        try:
            os.fchmod(fd, modo)
            if os.fstat(fd).st_gid != grupo:
                os.fchown(fd, -1, grupo)
            _escribir_todo(fd, (clave + "\n").encode("ascii"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(temporal, perfil + ".clave", src_dir_fd=dentro, dst_dir_fd=dentro)
    except BaseException:
        try:
            os.unlink(temporal, dir_fd=dentro)
        except OSError:
            pass
        raise
    finally:
        os.close(dentro)


def leer_clave(carpeta: str, perfil: str) -> str | None:
    try:
        dentro = os.open(carpeta, os.O_RDONLY | os.O_DIRECTORY | _CLOEXEC)
    except OSError:
        return None
    try:
        texto = (_leer(dentro, perfil + ".clave", 1024) or b"").decode("ascii", "replace").strip()
    except OSError:
        return None
    finally:
        os.close(dentro)
    return texto if texto and PATRON_CLAVE.fullmatch(texto) and '"' not in texto else None


def quitar_clave(carpeta: str, perfil: str) -> None:
    try:
        dentro = os.open(carpeta, os.O_RDONLY | os.O_DIRECTORY | _CLOEXEC)
    except OSError:
        return
    try:
        _quitar(dentro, perfil + ".clave")
    finally:
        os.close(dentro)


# MARK: El primer agente: la calma de Hermes, su flag y su unidad


def _json_de(carpeta: int, nombre: str):
    """El JSON de un fichero normal de `carpeta` (sin seguir enlaces), o None."""
    try:
        return json.loads((_leer(carpeta, nombre) or b"null").decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None


def _pid(valor) -> int | None:
    return valor if isinstance(valor, int) and not isinstance(valor, bool) and 0 < valor < 2 ** 31 else None


def vista_de_hermes(casa: str, servidos: list) -> dict:
    """Lo que dice Hermes de sí mismo en su casa, para saber si está tranquilo (`rato_tranquilo`) y qué proceso es su
    pasarela. De su `gateway_state.json` (`gateway/status.py`): `active_agents`, los turnos en marcha que su pasarela
    apunta en cada turno (`_persist_active_agents`: los chats, la API, cron y lo de segundo plano), y su `pid` (o el de
    su `gateway.pid`). Y la última vez que se escribió el `state.db` (o su `-wal`) de cada perfil que sirve, que es donde
    escribe cada turno. Sin seguir enlaces. `{"activos": int | None, "pid": int | None, "escrito": segundos | None}`: lo
    que no está o no tiene su forma, None."""
    vista = {"activos": None, "pid": None, "escrito": None}
    try:
        raiz = abrir_casa(casa, PRINCIPAL)
    except OSError:
        return vista
    try:
        estado = _json_de(raiz, ESTADO_DE_HERMES)
        if isinstance(estado, dict):
            activos = estado.get("active_agents")
            if isinstance(activos, int) and not isinstance(activos, bool) and activos >= 0:
                vista["activos"] = activos
            vista["pid"] = _pid(estado.get("pid"))
        if vista["pid"] is None:
            try:
                bruto = (_leer(raiz, PID_DE_HERMES, 64 * 1024) or b"").decode("utf-8", "replace").strip()
            except OSError:
                bruto = ""
            if bruto.isdigit():
                vista["pid"] = _pid(int(bruto))
            elif bruto.startswith("{"):
                try:
                    registro = json.loads(bruto)
                except ValueError:
                    registro = None
                vista["pid"] = _pid(registro.get("pid")) if isinstance(registro, dict) else None
    finally:
        os.close(raiz)
    escritos = []
    for perfil in [PRINCIPAL] + [p for p in servidos if isinstance(p, str) and PATRON_PERFIL.fullmatch(p)
                                 and p != PRINCIPAL]:
        try:
            carpeta = abrir_casa(casa, perfil)
        except OSError:
            continue
        try:
            for nombre in BASES:
                try:
                    visto = os.stat(nombre, dir_fd=carpeta, follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISREG(visto.st_mode):
                    escritos.append(visto.st_mtime)
        finally:
            os.close(carpeta)
    vista["escrito"] = max(escritos) if escritos else None
    return vista


def rato_tranquilo(vista: dict, ahora: float, calma: float = CALMA) -> tuple:
    """`(sí o no, qué lo impide, por qué)`: sin turnos en marcha y sin escribir en ninguna de sus bases en `calma`
    segundos (`qué` es `turnos` o `base`). Lo que Hermes no dice (un gateway_state.json sin `active_agents`, una casa
    sin state.db) no cuenta: queda lo demás."""
    activos = vista.get("activos")
    if isinstance(activos, int) and not isinstance(activos, bool) and activos > 0:
        return False, "turnos", "tiene %d %s en marcha" % (activos, "turno" if activos == 1 else "turnos")
    escrito = vista.get("escrito")
    if isinstance(escrito, (int, float)) and ahora - escrito < calma:
        return False, "base", "ha escrito en su base hace %d s" % max(0, ahora - escrito)
    return True, None, "tranquilo"


def unidad_del_cgroup(texto: str) -> str | None:
    """La unidad de systemd (del sistema o de un usuario) en la que corre un proceso, según su `/proc/<pid>/cgroup`: la
    última `.service` de su camino (el de la cgroup v2, o la línea `name=systemd` de la v1) que no sea el `user@….service`
    de un usuario, con sus escapes `\\xNN` deshechos. None si no corre en ninguna: una sesión, tmux, un contenedor."""
    camino = None
    for linea in (texto or "").splitlines():
        jerarquia, _, resto = linea.partition(":")
        controladores, _, ruta = resto.partition(":")
        if jerarquia == "0" and controladores == "" and ruta.strip() not in ("", "/"):
            camino = ruta.strip()
            break
        if "name=systemd" in controladores.split(",") and camino is None:
            camino = ruta.strip()
    if not camino:
        return None
    servicios = [parte for parte in camino.split("/")
                 if parte.endswith(".service") and not re.fullmatch(r"user@\d+\.service", parte)]
    if not servicios:
        return None
    unidad = re.sub(r"\\x([0-9a-fA-F]{2})", lambda escape: chr(int(escape.group(1), 16)), servicios[-1])
    return unidad if re.fullmatch(r"[A-Za-z0-9:_.@-]{1,200}\.service", unidad) else None


def config_de_hermes_multiplexa(casa: str) -> bool:
    """Si el config.yaml del principal ya le dice a Hermes que sirva todos los perfiles (`config_multiplexa`)."""
    carpeta = abrir_casa(casa, PRINCIPAL)
    try:
        texto = (_leer(carpeta, CONFIG) or b"").decode("utf-8", "replace")
    except OSError:
        texto = ""
    finally:
        os.close(carpeta)
    return config_multiplexa(texto)


# MARK: El sistema (lo que las pruebas cambian por dobles)


class Config:
    def __init__(self, casa="/root/.hermes", usuario_hermes="root", trabajo="/var/lib/hehermes-agentes",
                 claves_pasarela="/etc/hehermes-pasarela/agentes", claves_vigia="/etc/hehermes-avisos/agentes",
                 copias=None, unidad="hermes-gateway.service", puerto=None, hermes=None, usuario=False,
                 espera_flock=ESPERA_FLOCK):
        self.casa = casa.rstrip("/") or "/"
        self.usuario_hermes, self.trabajo = usuario_hermes, trabajo.rstrip("/")
        self.claves_pasarela, self.claves_vigia = claves_pasarela.rstrip("/"), claves_vigia.rstrip("/")
        self.copias, self.unidad, self.puerto, self.hermes = copias, unidad, puerto, hermes
        self.usuario, self.espera_flock = usuario, espera_flock


#: Adónde va lo que el `hermes` del ayudante intente sacar a internet: un puerto cerrado de localhost, que contesta que
#: no al momento. La jaula no deja salir (`IPAddressDeny=any`) y systemd tira esos paquetes sin contestar, así que lo
#: que Hermes intenta de red al arrancar se quedaba esperando unos 2 minutos: el 2026-10-06, crear un agente tardó 2
#: minutos, y `hermes profile list` en una jaula igual, 123 s; con esto, 5 s. Nada de lo que el ayudante le pide a
#: `hermes` (crear, describir, exportar, borrar, `config set`) necesita internet.
PROXY_CERRADO = "http://127.0.0.1:9"


class Sistema:
    """`hermes` como el dueño de Hermes, lo de su casa como él, su API en 127.0.0.1, su socket de control y su unidad.
    Las pruebas ponen dobles (`server/avisos/tests/agentes_apoyo.py`); nunca el Hermes de verdad."""

    def __init__(self, config: Config):
        self.config = config
        self._puerto = None

    def _del_dueno(self):
        """El usuario de Hermes, si este proceso es root y Hermes no: hay que hacerse él. Si no, None."""
        if os.geteuid() != 0 or self.config.usuario_hermes in ("", "root"):
            return None
        return pwd.getpwnam(self.config.usuario_hermes)

    def ejecutar(self, argv, entorno, plazo=PLAZO_HERMES, carpeta=None) -> tuple:
        """`(código, salida)` de una orden, como el dueño de Hermes: lo cambia el propio Python (setgid, setgroups,
        setuid) antes del exec, sin runuser ni PAM. Sin entrada, con su salida y sus errores juntos."""
        extra = {}
        dueno = self._del_dueno()
        if dueno is not None:
            extra = {"user": dueno.pw_uid, "group": dueno.pw_gid,
                     "extra_groups": os.getgrouplist(dueno.pw_name, dueno.pw_gid)}
        try:
            r = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               env=entorno, timeout=plazo, cwd=carpeta, check=False, **extra)
        except (OSError, subprocess.SubprocessError):
            return 127, ""
        return r.returncode, r.stdout[-64 * 1024:].decode("utf-8", "replace")

    def como_hermes(self, funcion):
        """Lo que se hace en la casa de Hermes, como su dueño. Con root y un Hermes de otro usuario, en un proceso hijo
        que se hace ese usuario y devuelve lo suyo por una tubería (en JSON): un enlace que dejara Hermes en su casa no
        lleva a root a ningún sitio. Si no, aquí mismo."""
        dueno = self._del_dueno()
        if dueno is None:
            return funcion()
        lectura, escritura = os.pipe()
        pid = os.fork()
        if pid == 0:  # pragma: no cover — solo con root, en el servidor
            try:
                os.close(lectura)
                os.setgroups(os.getgrouplist(dueno.pw_name, dueno.pw_gid))
                os.setgid(dueno.pw_gid)
                os.setuid(dueno.pw_uid)
                try:
                    salida = {"valor": funcion()}
                except Fallo as fallo:
                    salida = {"fallo": fallo.motivo}
                except Rechazo as rechazo:
                    salida = {"rechazo": [rechazo.http, rechazo.codigo, rechazo.mensaje]}
                except Exception as error:  # noqa: BLE001
                    salida = {"error": type(error).__name__}
                _escribir_todo(escritura, json.dumps(salida).encode("utf-8"))
            finally:
                os._exit(0)
        os.close(escritura)
        partes = []
        try:
            while True:
                trozo = os.read(lectura, 65536)
                if not trozo:
                    break
                partes.append(trozo)
        finally:
            os.close(lectura)
            os.waitpid(pid, 0)
        try:
            salida = json.loads(b"".join(partes).decode("utf-8"))
        except ValueError:
            raise Fallo("interna") from None
        if "fallo" in salida:
            raise Fallo(salida["fallo"] if salida["fallo"] in MOTIVOS else "interna")
        if "rechazo" in salida:
            raise Rechazo(*salida["rechazo"])
        if "valor" not in salida:
            raise OSError(errno.EIO, "como_hermes: %s" % salida.get("error"))
        return salida["valor"]

    def hermes(self) -> str | None:
        """El `hermes` de esa casa: el que se dio, el de la unidad de Hermes, o uno de los de siempre."""
        if self.config.hermes:
            return self.config.hermes
        candidatas = []
        if self.config.unidad:
            codigo, salida = self._systemctl(["show", self.config.unidad, "-p", "ExecStart", "--value"], 20)
            for trozo in salida.replace(";", " ").split():
                if trozo.startswith("path=") and trozo.endswith("/hermes"):
                    candidatas.append(trozo[5:])
        casa = self.casa_del_dueno()
        candidatas += ["/usr/local/bin/hermes", casa + "/.local/bin/hermes" if casa else None, "/usr/bin/hermes"]
        for candidata in candidatas:
            if candidata and os.path.isfile(candidata) and os.access(candidata, os.X_OK):
                return candidata
        return None

    def casa_del_dueno(self) -> str | None:
        try:
            return pwd.getpwnam(self.config.usuario_hermes).pw_dir
        except KeyError:
            return None

    def entorno_de_hermes(self) -> dict:
        casa = self.casa_del_dueno() or os.path.dirname(self.config.casa)
        entorno = {"HERMES_HOME": self.config.casa, "HOME": casa, "USER": self.config.usuario_hermes,
                   "LOGNAME": self.config.usuario_hermes, "LANG": "C.UTF-8", "NO_COLOR": "1", "TERM": "dumb",
                   "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
        # Lo de fuera, al puerto cerrado (`PROXY_CERRADO`); lo de esta máquina, directo.
        entorno.update({clave: PROXY_CERRADO for clave in ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "https_proxy",
                                                           "http_proxy", "all_proxy")})
        entorno.update(NO_PROXY="localhost,127.0.0.1,::1", no_proxy="localhost,127.0.0.1,::1")
        return entorno

    def _systemctl(self, argumentos, plazo) -> tuple:
        orden = ["systemctl"] + (["--user"] if self.config.usuario else []) + list(argumentos)
        try:
            r = subprocess.run(orden, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               timeout=plazo, check=False)
        except (OSError, subprocess.SubprocessError):
            return 127, ""
        return r.returncode, r.stdout.decode("utf-8", "replace")

    def estado_de_la_unidad(self) -> dict:
        """`LoadState`, `ActiveState` y `MainPID` de la unidad de Hermes, según systemd. Vacío si no contesta."""
        codigo, salida = self._systemctl(["show", self.config.unidad, "-p", "LoadState", "-p", "ActiveState", "-p",
                                          "MainPID"], 20)
        estado = {}
        for linea in salida.splitlines() if codigo == 0 else ():
            clave, igual, valor = linea.partition("=")
            if igual and clave in ("LoadState", "ActiveState", "MainPID"):
                estado[clave] = valor.strip()
        return estado

    def cgroup(self, pid: int) -> str | None:
        """Lo que dice `/proc/<pid>/cgroup` (en qué unidad corre ese proceso), o None si no está."""
        try:
            with open("/proc/%d/cgroup" % pid, "rb") as fichero:
                return fichero.read(64 * 1024).decode("utf-8", "replace")
        except (OSError, TypeError, ValueError):
            return None

    def reiniciar_hermes(self) -> bool:
        """`systemctl restart` de la unidad de Hermes: systemd la para como diga ella (la del VPS de pruebas,
        `KillMode=mixed` y `TimeoutStopSec=210`: SIGTERM a la pasarela, que drena lo que tenga en marcha,
        `runner.stop()`) y la vuelve a arrancar. La misma unidad: nunca otra, ni otra pasarela suelta, ni se reescribe
        nada de ella (lo que haría `hermes gateway restart`, `refresh_systemd_unit_if_needed`)."""
        codigo, _ = self._systemctl(["restart", self.config.unidad], PLAZO_REINICIO)
        return codigo == 0

    def repasar_perfiles(self) -> dict | None:
        """Le pide a la pasarela de Hermes que vuelva a mirar `profiles/` ya (`rescan-profiles`, lo mismo que hace
        `hermes profile create`), en vez de esperar a su repaso de cada 30 s. Como el dueño de Hermes: su socket es
        suyo (0600). Lo que contesta (`served_profiles`, `multiplex`…), o None si no contesta."""
        casa = self.config.casa
        try:
            return self.como_hermes(lambda: pedir_al_socket_de_control(casa, "rescan-profiles", PLAZO_CONTROL))
        except (OSError, Fallo):
            return None

    def puerto(self) -> int:
        """El de la API de Hermes: el que se dio, o el `API_SERVER_PORT` de su .env (8642 si no dice). Se lee una vez."""
        if self.config.puerto:
            return self.config.puerto
        if self._puerto is None:
            self._puerto = self._puerto_del_env()
        return self._puerto

    def _puerto_del_env(self) -> int:
        try:
            texto = self.como_hermes(lambda: (_leer_env_principal(self.config.casa) or b"").decode("utf-8", "replace"))
        except (OSError, Fallo):
            texto = ""
        for linea in texto.splitlines():
            nombre, _, valor = linea.partition("=")
            valor = valor.strip().strip("'\"")
            if nombre.replace("export", "").strip() == "API_SERVER_PORT" and valor.isdigit() and \
                    0 < int(valor) < 65536:
                return int(valor)
        return 8642

    def http(self, ruta: str, clave: str | None = None, plazo: float = 5.0) -> tuple:
        """`GET` a la API de Hermes en 127.0.0.1, con la clave en su cabecera (nunca en la ruta ni en el registro)."""
        try:
            conexion = http.client.HTTPConnection("127.0.0.1", self.puerto(), timeout=plazo)
            try:
                conexion.request("GET", ruta, headers={"Authorization": "Bearer " + clave} if clave else {})
                respuesta = conexion.getresponse()
                return respuesta.status, respuesta.read(1024 * 1024)
            finally:
                conexion.close()
        except (OSError, http.client.HTTPException):
            return None, b""

    def libre(self, ruta: str) -> int:
        return shutil.disk_usage(ruta).free

    def ahora(self) -> float:
        return time.time()

    def dormir(self, segundos: float) -> None:
        time.sleep(segundos)


def pedir_al_socket_de_control(casa: str, verbo: str, plazo: float) -> dict | None:
    """Un verbo del socket de control de la pasarela de Hermes (`gateway/control_socket.py` de la 0.21.5): una línea
    JSON (`{"verb", "id", "protocol": 1}`) y otra de vuelta (`{"ok": true, "result": {…}}`), una por conexión. El
    socket es `<casa>/gateway.sock`, o el que diga `gateway.sock.path` si su ruta no cabía. Lo que contesta en `result`,
    o None si no hay socket, no contesta a tiempo o contesta otra cosa."""
    ruta = os.path.join(casa, SOCKET_DE_CONTROL)
    if not os.path.exists(ruta):
        try:
            with open(os.path.join(casa, PUNTERO_DEL_SOCKET), encoding="utf-8") as fichero:
                ruta = fichero.read(4096).strip()
        except (OSError, UnicodeDecodeError):
            return None
        if not ruta.startswith("/") or not os.path.exists(ruta):
            return None
    peticion = json.dumps({"verb": verbo, "id": 1, "protocol": 1}).encode("utf-8") + b"\n"
    limite = time.monotonic() + plazo
    recibido = b""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conexion:
            conexion.settimeout(plazo)
            conexion.connect(ruta)
            conexion.sendall(peticion)
            while b"\n" not in recibido and len(recibido) <= 512 * 1024 and time.monotonic() < limite:
                trozo = conexion.recv(65536)
                if not trozo:
                    break
                recibido += trozo
    except OSError:
        return None
    try:
        respuesta = json.loads(recibido.partition(b"\n")[0].decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return None
    resultado = respuesta.get("result") if isinstance(respuesta, dict) and respuesta.get("ok") is True else None
    return resultado if isinstance(resultado, dict) else None


def _leer_env_principal(casa: str) -> bytes | None:
    carpeta = abrir_casa(casa, PRINCIPAL)
    try:
        return _leer(carpeta, ENV)
    finally:
        os.close(carpeta)


# MARK: Los trabajos


def _escribir_json(ruta: str, datos) -> None:
    temporal = ruta + ".nuevo"
    with open(os.open(temporal, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "w") as f:
        json.dump(datos, f, sort_keys=True, separators=(",", ":"))
    os.replace(temporal, ruta)


def _leer_json(ruta: str):
    try:
        with open(ruta, "rb") as f:
            return json.loads(f.read(64 * 1024).decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None


class Trabajos:
    """La carpeta de trabajo (0700, solo del ayudante): el estado de cada trabajo, el cerrojo (uno a la vez) y lo que
    se vio de la memoria en la vuelta anterior. Se crea al hacer falta, no antes."""

    def __init__(self, config: Config, sistema: Sistema):
        self.config, self.sistema = config, sistema
        self._cerrojo = None

    def ruta(self, *partes) -> str:
        return os.path.join(self.config.trabajo, *partes)

    def _preparar(self) -> None:
        os.makedirs(self.ruta("trabajos"), mode=0o700, exist_ok=True)
        os.chmod(self.config.trabajo, 0o700)

    def tomar(self) -> bool:
        """El cerrojo, sin esperar. False si lo tiene otro (otra conexión, o un trabajo que sigue)."""
        if self._cerrojo is not None:
            return True
        self._preparar()
        fd = os.open(self.ruta("trabajo.lock"), os.O_RDWR | os.O_CREAT | _CLOEXEC, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(fd)
            return False
        self._cerrojo = fd
        return True

    def soltar(self) -> None:
        if self._cerrojo is not None:
            fcntl.flock(self._cerrojo, fcntl.LOCK_UN)
            os.close(self._cerrojo)
            self._cerrojo = None

    def en_marcha(self) -> bool:
        """Si hay un trabajo en marcha, por lo que dice su estado y su latido: sin tocar el cerrojo, así que `listar` ni
        espera a nadie ni estorba a quien lo pide en ese momento."""
        try:
            nombres = os.listdir(self.ruta("trabajos"))
        except OSError:
            return False
        ahora = self.sistema.ahora()
        for nombre in nombres:
            datos = _leer_json(self.ruta("trabajos", nombre))
            if isinstance(datos, dict) and datos.get("estado") in EN_MARCHA and isinstance(datos.get("latido"), int) \
                    and ahora - datos["latido"] <= SIN_LATIDO:
                return True
        return False

    def ocupado(self) -> bool:
        """Si hay un trabajo en marcha, aquí o en otro proceso: por el cerrojo (solo para dar por muerto uno sin
        latido)."""
        if self._cerrojo is not None:
            return True
        if not os.path.exists(self.ruta("trabajo.lock")):
            return False
        if not self.tomar():
            return True
        self.soltar()
        return False

    def nuevo(self, tipo: str, perfil: str) -> str:
        id_ = secrets.token_hex(16)
        ahora = int(self.sistema.ahora())
        _escribir_json(self.ruta("trabajos", id_ + ".json"), {"id": id_, "tipo": tipo, "perfil": perfil,
                                                              "estado": "en_cola", "motivo": None, "creado": ahora,
                                                              "latido": ahora})
        return id_

    def poner(self, id_: str, **cambios) -> None:
        ruta = self.ruta("trabajos", id_ + ".json")
        datos = _leer_json(ruta)
        if not isinstance(datos, dict):
            return
        datos.update(cambios)
        datos["latido"] = int(self.sistema.ahora())
        _escribir_json(ruta, datos)

    def leer(self, id_: str) -> dict | None:
        datos = _leer_json(self.ruta("trabajos", id_ + ".json"))
        if not (isinstance(datos, dict) and datos.get("estado") in ESTADOS and datos.get("tipo") in TIPOS
                and isinstance(datos.get("perfil"), str) and PATRON_PERFIL.fullmatch(datos["perfil"])):
            return None
        latido = datos.get("latido") if isinstance(datos.get("latido"), int) else 0
        if datos["estado"] in EN_MARCHA and self.sistema.ahora() - latido > SIN_LATIDO and not self.ocupado():
            # Nadie con el cerrojo y sin latido: el proceso murió a medias (un reinicio, un kill).
            self.poner(id_, estado="fallo", motivo="interrumpido")
            _decir("trabajo %s (%s %s): interrumpido" % (id_[:8], datos["tipo"], datos["perfil"]))
            datos.update(estado="fallo", motivo="interrumpido")
        motivo = datos.get("motivo")
        salida = {"estado": datos["estado"], "tipo": datos["tipo"], "perfil": datos["perfil"],
                  "motivo": motivo if datos["estado"] == "fallo" and motivo in MOTIVOS else None}
        # En qué está, solo mientras crea el primer agente (espera a Hermes o lo reinicia): opcional en §18.4.
        if datos["estado"] == "creando" and datos.get("paso") in PASOS:
            salida["paso"] = datos["paso"]
        return salida

    def limpiar(self) -> None:
        """Los de hace más de un día se olvidan: ninguno sigue en marcha (systemd no deja a un ayudante más de media
        hora, `RuntimeMaxSec`)."""
        try:
            nombres = os.listdir(self.ruta("trabajos"))
        except OSError:
            return
        ahora = self.sistema.ahora()
        for nombre in nombres:
            ruta = self.ruta("trabajos", nombre)
            datos = _leer_json(ruta)
            creado = datos.get("creado") if isinstance(datos, dict) and isinstance(datos.get("creado"), int) else 0
            if ahora - creado > VIDA_TRABAJO:
                try:
                    os.unlink(ruta)
                except OSError:
                    pass


