# Configuración del vigía de avisos de HeHermes.
# Va en /etc/hehermes-avisos/vigia.ini (root:hh-vigia, 0640). Aquí no hay secretos: solo dónde están.
# Tras cambiarla: sudo systemctl restart hehermes-vigia

[vigia]
# Donde escucha la API para la app. Solo en 127.0.0.1: la app llega por el nginx del túnel (location /avisos/).
escucha = 127.0.0.1:8790
# La memoria del vigía: dispositivos (con la clave de cada iPhone) y hasta dónde ha leído cada conversación.
# systemd crea la carpeta con StateDirectory=, del usuario hh-vigia y 0700.
base_de_datos = /var/lib/hehermes-vigia/vigia.db
# Segundos entre dos lecturas de la bandeja de Hermes mientras pasa algo (una conversación cambia, una app está delante
# o se acaba de ir, hay algo pendiente), y tras tres minutos de calma. Sin ningún iPhone dado de alta no se lee nada.
intervalo = 5
intervalo_en_calma = 25
# Lo escrito en Hermes hace más de esto (segundos) no se avisa aunque el vigía no lo haya visto: tras un reinicio largo,
# un aviso de hace una hora es ruido.
antiguedad_maxima = 900
# Filas que se leen de una conversación que ha cambiado (como la revisión de subagentes de la app).
filas_por_lectura = 100
# iPhone que se recuerdan como mucho; por encima, se olvida el que lleva más tiempo sin darse de alta.
max_dispositivos = 20
# Segundos que Apple guarda un aviso de aprobación o de prueba si el iPhone no está localizable. Pasado eso ya no sirve.
caducidad_aprobacion = 120
caducidad_prueba = 300
registro = INFO
# El secreto que pone nginx en cada petición de /avisos/ (cabecera X-HeHermes-Vigia): sin él, la API no atiende nada.
# Fichero 0600 de hh-vigia; lo crea el instalador, a la vez que /etc/nginx/hehermes-avisos/secreto/vigia.conf, y no
# lo pisa.
secreto_tunel = /etc/hehermes-avisos/vigia/secreto-tunel

[hermes]
# Directo al api_server, no por el nginx del túnel: ese pone el Bearer a cualquier conexión local, y así el vigía no
# depende de ello.
base = http://127.0.0.1:8642
# La API_SERVER_KEY, en un fichero 0600 de hh-vigia. La escribe `sudo hehermes-dispositivo clave`, igual que la de
# nginx: si la clave cambia, esa orden lo arregla todo y reinicia el vigía.
clave = /etc/hehermes-avisos/vigia/clave-hermes
plazo = 15

[rele]
# El relé de esta misma máquina, en claro por 127.0.0.1. El de otra (la entrada pública del de Daniel, para el vigía de
# un probador) va por https://<dirección>:<puerto>/v1/avisos con «huella = <la del código de avisos>», que se ancla: sin
# huella no se habla HTTPS con nadie, y en claro solo con 127.0.0.1 (la credencial va en cada aviso). Eso lo escribe el
# instalador (hehermes-servidor avisos). Vacía («url =», o sin ponerla), el vigía va sin credencial: cada aviso sale
# con el permiso que la app le da en el alta de cada iPhone (App Attest), hacia la entrada pública del relé que trae
# con él; es lo que pone el instalador 0.8.0 sin código de avisos.
url = http://127.0.0.1:8791/v1/avisos
# La credencial de este vigía ante el relé (fichero 0600 de hh-vigia). La crea el instalador.
credencial = /etc/hehermes-avisos/vigia/credencial-rele
# Menos que los 10 s que espera la app al pedir el aviso de prueba, que espera la respuesta de Apple, y más que lo
# que puede tardar el relé con Apple ([rele] plazo_apns, 6 s).
plazo = 8

[entregas]
# Cuando un subagente en segundo plano acaba, Hermes deja su entrega en el historial y no lanza ningún turno: lo lanza la
# app si está viva. Con el iPhone dormido nadie lo hacía y la respuesta no llegaba hasta el siguiente mensaje de Daniel.
# Con esto encendido, el vigía lanza él el turno de continuación de la app (el mismo texto, la misma clave de
# idempotencia) y el aviso que llega es el de la respuesta. «no» vuelve a lo de antes: solo avisa de la entrega.
contestar = sí
# Segundos que se deja a la app, si está delante, para lanzar la suya (con las instrucciones y el esfuerzo de la
# conversación, que el vigía no conoce). Como mínimo 30.
gracia = 60
# Una entrega sin contestar más vieja que esto (segundos) ya no se contesta: tras un reinicio largo, no se despiertan
# conversaciones de ayer.
antiguedad_maxima = 10800
# Continuaciones seguidas sin un mensaje de Daniel en medio tras las que el vigía se para (Hermes puede volver a delegar
# al recibir cada entrega): a partir de ahí solo avisa de la entrega.
cadena_maxima = 3

[ficheros]
# Los ficheros que Hermes marca con MEDIA: (GET /avisos/v1/fichero). Los lee como root el lector de
# /usr/local/libexec/hehermes-leer-media, que systemd lanza por cada conexión a este socket (root:hh-vigia 0660).
# Vacío: sin lector (el del instalador), y esa ruta contesta 503.
lector = /run/hehermes-leer-media.sock
# Lo que vale «~» en una línea MEDIA:~/… (Hermes corre como root).
casa = /root
# Descargas por minuto (cuentan también las que no estaban marcadas) y a la vez.
por_minuto = 30
simultaneos = 2

[exportaciones]
# Desde la 1.5.1: el vigía vigila la carpeta de Hermes para el iPhone (<HERMES_HOME>/exports) por el mismo lector de
# [ficheros] y avisa de cada fichero nuevo («Nuevo fichero listo: <nombre>», de tipo segundo plano), aunque Hermes aún
# no haya escrito su línea MEDIA:. Sin lector, no vigila. «no» lo apaga.
vigilar = sí
# Segundos que un fichero nuevo tiene que quedarse igual para avisar de él (no se avisa a medias). Como mínimo 2.
estabilidad = 5
# Lo que llegó a la carpeta hace más de esto (segundos; el vigía estuvo parado) se apunta sin avisar.
antiguedad_maxima = 3600

[respaldo]
# La copia de Hermes en iCloud (/avisos/v1/respaldo/…, contrato §15). La hace el ayudante de root de
# /usr/local/libexec/hehermes-respaldo, que systemd lanza por cada conexión a este socket (root:hh-vigia 0660).
# Vacío: sin copia, y esas rutas contestan 503.
ayudante = /run/hehermes-respaldo.sock
