# /etc/systemd/system/hehermes-leer-media@.service
# Un lector por conexión a /run/hehermes-leer-media.sock (hehermes-leer-media.socket, Accept=yes): lee una línea con la
# ruta y contesta con el fichero por el mismo socket. Es root, porque Hermes es root y deja sus ficheros donde quiere,
# pero con lo justo para leer y nada más.
[Unit]
Description=HeHermes: lector de un fichero que Hermes marcó
Documentation=file:///opt/hehermes-avisos/src/README.md
# Cada rechazo sale con su código (hehermes-leer-media, SALIDAS): que no se acumulen en `systemctl --failed`. Lo que
# pasó queda en el registro (journalctl -u 'hehermes-leer-media@*').
CollectMode=inactive-or-failed

[Service]
Type=simple
# Python del sistema, sin nada del entorno ni del directorio (-I), sin site (-S: no hace falta ningún paquete) y sin
# escribir bytecode (-B).
# La carpeta de Hermes, prohibida salvo sus caches. Si el entorno de hermes-gateway dice otra, instalar.sh deja un
# añadido (hehermes-leer-media@.service.d/hermes-home.conf) que cambia esta línea y la de los secretos de abajo.
ExecStart=/usr/bin/python3 -I -S -B /usr/local/libexec/hehermes-leer-media --hermes-home=/root/.hermes --conexion
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Los rechazos de siempre (ruta inválida, no existe, prohibida, no es un fichero, demasiado grande) no son un fallo
# del servicio. Una carrera (7), un error de lectura (8) o alguien que no es el vigía (9), sí.
SuccessExitStatus=2 3 4 5 6
# 50 MB por una VPN lenta caben de sobra.
RuntimeMaxSec=900
UMask=0077
LimitCORE=0

# Leer, y solo leer: todo el sistema de ficheros de solo lectura, y de las capacidades de root solo la de leer y
# recorrer carpetas de cualquiera (CAP_DAC_READ_SEARCH). Ni red ni dispositivos.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Sin PrivateTmp a propósito: Hermes deja ficheros en /tmp, y el lector tiene que ver el /tmp de verdad.

# La lista de prohibidas del lector, otra vez, pero ahora la hace cumplir el núcleo: aunque el código tuviera un fallo,
# aquí dentro estas rutas están tapadas (vacías). /proc, /sys, /dev y /run ya los recortan las líneas de arriba, y lo
# que el lector prohíbe por su nombre en cualquier sitio (.ssh, .gnupg, .env) se tapa donde se sabe que está.
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d
InaccessiblePaths=-/etc/ssh -/etc/ssl/private -/etc/letsencrypt
InaccessiblePaths=-/etc/hehermes -/etc/hehermes-avisos -/var/lib/hehermes-vigia
InaccessiblePaths=-/etc/nginx -/etc/swanctl -/etc/strongswan -/etc/ipsec.secrets -/etc/ipsec.d -/etc/wireguard
InaccessiblePaths=-/root/.ssh -/root/.gnupg
# Lo que se sabe que hay en la carpeta de Hermes, fuera de sus caches (el lector prohíbe además todo lo demás de ella,
# también las copias .bak, que no tienen un nombre fijo).
InaccessiblePaths=-/root/.hermes/.env -/root/.hermes/auth.json -/root/.hermes/config.yaml -/root/.hermes/state.db
InaccessiblePaths=-/root/.hermes/state.db-wal -/root/.hermes/state.db-shm -/root/.hermes/SOUL.md
InaccessiblePaths=-/root/.hermes/backups -/root/.hermes/cron -/root/.hermes/hooks -/root/.hermes/engagements
