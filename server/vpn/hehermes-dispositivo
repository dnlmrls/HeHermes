#!/usr/bin/env python3
"""hehermes-dispositivo: los iPhone de la pasarela TLS de HeHermes (altas, bajas y tokens nuevos), y las bajas de la VPN.

Uso (como root, con sudo; sin root también, si la pasarela la instaló ese usuario):
  hehermes-dispositivo alta <nombre> [--tls]    # el token nuevo y su QR (hehermes-tls:1?…), solo en un terminal
  hehermes-dispositivo baja <nombre> [--tls|--ikev2]   # su token (o su acceso a la VPN de antes) deja de valer
  hehermes-dispositivo rotar <nombre> [--tls]   # otro token y su QR, si el QR ha podido verse; el de antes deja de valer
  hehermes-dispositivo lista                # todos, con su modo: tls, o ikev2 y wireguard los de la VPN de antes
  hehermes-dispositivo limpiar <nombre>     # borra del VPS el .conf con la clave privada de un WireGuard de antes
  hehermes-dispositivo clave                # recarga en nginx (y en el vigía de avisos) la clave del api_server
  hehermes-dispositivo clave --solo-vigia   # solo la copia del vigía, sin tocar nginx (el instalador de avisos)
  hehermes-dispositivo estado               # cómo está lo de la VPN de antes (WireGuard e IKEv2)

La pasarela TLS (`server/instalador`) tiene su propio `pasarela.ini`: el de root en `/etc/hehermes-pasarela`, o el de
un usuario en `~/.config/hehermes-pasarela`. Sus iPhone van en su `tokens.json`, que solo guarda el SHA-256 de cada
token: el QR sale una vez, al dar el alta o al rotar, y en un terminal. El código de los tokens y del QR es el del
instalador (`[instalador] codigo`), el mismo que usa la pasarela.

La VPN (IKEv2 y, antes, WireGuard) ya no da altas nuevas ni rota claves: desde la versión 0.6.0 del instalador, la app
solo usa la pasarela. Lo que quede de ella se sigue viendo en `lista` y se da de baja con `baja`: el registro
(`dispositivos.json`) dice quién hay; un dispositivo IKEv2 tiene su conexión de strongSwan en
`/etc/swanctl/conf.d/hehermes-<nombre>.conf`, donde vive su clave compartida, y darlo de baja es quitar ese fichero,
recargar y cortar su sesión; uno de WireGuard, regenerar `wg0.conf` sin él y aplicarlo en caliente con `wg syncconf`.
Si existe `/etc/hehermes/servidor.ini` (lo dejaba la VPN del instalador), de ahí salen el .env de Hermes, la carpeta
del registro y la de swanctl; sin él, los de una instalación a mano. El script nunca escribe una clave ni la
API_SERVER_KEY en la salida, salvo el QR de la pasarela, que se niega a pintar si no lo pide una persona desde un
terminal (con sudo, como root).
"""

import configparser
import datetime
import ipaddress
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

DIR = "/etc/wireguard"
DIR_HH = os.path.join(DIR, "hehermes")
REGISTRO = os.path.join(DIR_HH, "dispositivos.json")
CLAVE_SERVIDOR = os.path.join(DIR, "servidor.key")
WG_CONF = os.path.join(DIR, "wg0.conf")
INTERFAZ = "wg0"
RED = ipaddress.ip_network("10.77.0.0/24")
IP_SERVIDOR = ipaddress.ip_address("10.77.0.1")
PUERTO = 51820
ENV_HERMES = "/root/.hermes/.env"
BEARER_NGINX = "/etc/nginx/hehermes-bearer.conf"
# El vigía de avisos (server/avisos) lee al api_server directo, con su propia copia de la clave: así no depende del
# nginx del túnel. Solo si está instalado (existe su carpeta).
DIR_VIGIA = "/etc/hehermes-avisos/vigia"
CLAVE_VIGIA = os.path.join(DIR_VIGIA, "clave-hermes")
USUARIO_VIGIA = "hh-vigia"
SERVICIO_VIGIA = "hehermes-vigia"
NOMBRE_VALIDO = re.compile(r"^[a-z0-9][a-z0-9-]{0,30}$")

# Las conexiones IKEv2 de la VPN de antes: cada dispositivo, en su propio fichero de conf.d. Los que no escribió este
# script (el `hehermes-poc.conf` que se escribió a mano para el iPhone de Daniel, `hh-iphone-poc`) ni se reescriben ni
# se borran.
DIR_SWANCTL = "/etc/swanctl/conf.d"
# La primera línea de cada fichero que escribía el script. Es lo que distingue los suyos de los escritos a mano.
CABECERA_SWANCTL = "# Generado por hehermes-dispositivo. No editar a mano: usa el script.\n"
SERVIDOR_INI = "/etc/hehermes/servidor.ini"

#: Lo que dice quien pida lo que ya no existe.
SIN_VPN = ("la VPN IKEv2 ya no da altas nuevas ni cambia claves: desde la versión 0.6.0 del instalador, la app solo usa "
           "la conexión directa (la pasarela TLS). Dalo de alta ahí: sudo hehermes-dispositivo alta <nombre>. Lo que "
           "quede de la VPN se da de baja con: sudo hehermes-dispositivo baja <nombre>")
SIN_WIREGUARD = ("WireGuard ya no da altas nuevas: la app solo usa la conexión directa (la pasarela TLS). Dalo de alta "
                 "ahí: sudo hehermes-dispositivo alta <nombre>")


def aplicar_servidor_ini(ruta=SERVIDOR_INI):
    """Lo que la VPN del instalador dejaba escrito de este servidor: dónde está el .env de Hermes, dónde va el registro
    y dónde tiene swanctl su configuración (en la familia Red Hat, `/etc/strongswan/swanctl`). Sin el fichero, lo de
    una instalación a mano."""
    global ENV_HERMES, DIR_HH, REGISTRO, DIR_SWANCTL
    if not os.path.exists(ruta):
        return
    ini = configparser.ConfigParser()
    try:
        ini.read(ruta)
    except configparser.Error as error:
        fallar("%s no se puede leer: %s" % (ruta, error))
    ENV_HERMES = ini.get("hermes", "env", fallback=ENV_HERMES)
    registro = ini.get("dispositivos", "registro", fallback=None)
    if registro:
        DIR_HH = registro
        REGISTRO = os.path.join(DIR_HH, "dispositivos.json")
    swanctl = ini.get("strongswan", "carpeta", fallback=None)
    if swanctl:
        if not swanctl.startswith("/"):
            fallar("la carpeta de strongswan de %s no es una ruta absoluta" % ruta)
        DIR_SWANCTL = os.path.join(swanctl, "conf.d")


def leer_clave_del_env(texto):
    """La API_SERVER_KEY de un .env, como lo escribe la gente: con `export`, comillas o un comentario detrás."""
    clave = None
    for linea in texto.splitlines():
        m = re.match(r"^\s*(?:export\s+)?API_SERVER_KEY\s*=\s*(.*?)\s*$", linea)
        if not m:
            continue
        valor = m.group(1)
        if valor[:1] in ("'", '"') and valor.find(valor[0], 1) > 0:
            valor = valor[1:valor.find(valor[0], 1)]
        else:
            valor = re.split(r"\s+#", valor, maxsplit=1)[0].strip()
        clave = valor
    return clave


def fallar(mensaje):
    print("error: " + mensaje, file=sys.stderr)
    sys.exit(1)


def ejecutar(*args, entrada=None):
    r = subprocess.run(args, input=entrada, capture_output=True, text=True)
    if r.returncode != 0:
        fallar("%s falló: %s" % (args[0], r.stderr.strip()))
    return r.stdout


def ahora():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def escribir_privado(ruta, contenido, uid=None, gid=None):
    """Escribe con permisos 0600 de forma atómica, y del dueño que se diga (root si no)."""
    carpeta = os.path.dirname(ruta)
    fd, tmp = tempfile.mkstemp(dir=carpeta, prefix=".tmp-")
    try:
        os.fchmod(fd, 0o600)
        if uid is not None:
            # Antes del rename: el fichero nunca existe en su sitio con otro dueño.
            os.fchown(fd, uid, gid)
        with os.fdopen(fd, "w") as f:
            f.write(contenido)
        os.replace(tmp, ruta)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def leer_registro():
    if not os.path.exists(REGISTRO):
        return {"dispositivos": []}
    with open(REGISTRO) as f:
        return json.load(f)


def guardar_registro(registro):
    escribir_privado(REGISTRO, json.dumps(registro, indent=2, ensure_ascii=False) + "\n")


def activos(registro):
    return [d for d in registro["dispositivos"] if not d.get("baja")]


def buscar(registro, nombre):
    for d in activos(registro):
        if d["nombre"] == nombre:
            return d
    return None


def tipo(d):
    """Los registros de antes de IKEv2 no llevan `tipo`: todos eran de WireGuard."""
    return d.get("tipo", "wireguard")


def aplicar(registro):
    """Regenera wg0.conf desde el registro y lo aplica sin cortar el túnel: así se va un WireGuard dado de baja."""
    with open(CLAVE_SERVIDOR) as f:
        privada = f.read().strip()
    partes = [
        "# Generado por hehermes-dispositivo. No editar a mano: usa el script.\n"
        "[Interface]\nAddress = %s/%d\nListenPort = %d\nPrivateKey = %s\n"
        % (IP_SERVIDOR, RED.prefixlen, PUERTO, privada)
    ]
    for d in activos(registro):
        if tipo(d) != "wireguard":
            continue
        partes.append("\n# %s\n[Peer]\nPublicKey = %s\nAllowedIPs = %s/32\n" % (d["nombre"], d["clavePublica"], d["ip"]))
    escribir_privado(WG_CONF, "".join(partes))
    if subprocess.run(["ip", "link", "show", INTERFAZ], capture_output=True).returncode == 0:
        despojada = ejecutar("wg-quick", "strip", INTERFAZ)
        fd, tmp = tempfile.mkstemp(dir=DIR, prefix=".tmp-strip-")
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(despojada)
            ejecutar("wg", "syncconf", INTERFAZ, tmp)
        finally:
            os.unlink(tmp)


def correr(*args, entrada=None):
    """Como `ejecutar`, pero sin salir si falla: para lo que hay que deshacer o seguir haciendo aunque algo falle."""
    return subprocess.run(args, input=entrada, capture_output=True, text=True)


# MARK: Las altas IKEv2 de antes


def ruta_swanctl(nombre):
    return os.path.join(DIR_SWANCTL, "hehermes-%s.conf" % nombre)


def es_nuestro(ruta):
    try:
        with open(ruta, errors="replace") as f:
            return f.readline() == CABECERA_SWANCTL
    except FileNotFoundError:
        return False


def cargar_swanctl():
    """`--load-all` carga lo que hay en conf.d y descarga lo que ya no está, sin tocar las sesiones de las conexiones
    que siguen igual: los demás dispositivos no se enteran. `--noprompt`, para que nunca se quede esperando una
    contraseña de clave privada."""
    return correr("swanctl", "--load-all", "--noprompt")


def sas_ikev2():
    """El estado de cada IKE_SA por nombre de conexión (`ESTABLISHED`, `CONNECTING`…); `None` si no se puede mirar."""
    if not shutil.which("swanctl"):
        return None
    r = correr("swanctl", "--list-sas")
    if r.returncode != 0:
        return None
    return dict(re.findall(r"^([\w.-]+): #\d+, (\w+),", r.stdout, re.M))


def baja_ikev2(d):
    ruta = ruta_swanctl(d["nombre"])
    if os.path.exists(ruta) and es_nuestro(ruta):
        os.unlink(ruta)
    r = cargar_swanctl()
    # Sin esto la sesión viva sigue: ni el rekey de IKE ni el del Child vuelven a mirar las credenciales.
    t = correr("swanctl", "--terminate", "--ike", d["conexion"], "--force")
    if r.returncode != 0:
        fallar("el fichero ya no está, pero swanctl no ha recargado (%s): la conexión de «%s» puede seguir cargada. "
               "Arréglalo y ejecuta swanctl --load-all --noprompt" % ((r.stderr or r.stdout).strip(), d["nombre"]))
    if t.returncode != 0 and "no matching" not in (t.stdout + t.stderr).lower():
        fallar("swanctl --terminate ha fallado (%s): corta la sesión a mano con "
               "swanctl --terminate --ike %s --force" % ((t.stderr or t.stdout).strip(), d["conexion"]))


# MARK: La pasarela TLS

PASARELA_INI_ROOT = "/etc/hehermes-pasarela/pasarela.ini"
_pasarela = None


def ruta_pasarela_ini():
    if os.geteuid() == 0:
        return PASARELA_INI_ROOT
    return os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".config", "hehermes-pasarela", "pasarela.ini")


def de_fiar(ruta):
    """Lo que el script lee para importar código tiene que ser de quien lo ejecuta (o de root) y que nadie más pueda
    escribirlo: como root, importar de una carpeta que otro puede tocar sería darle root."""
    datos = os.lstat(ruta)
    if stat.S_ISLNK(datos.st_mode):
        fallar("%s es un enlace: no lo sigo" % ruta)
    if datos.st_uid not in (0, os.geteuid()) or datos.st_mode & 0o022:
        fallar("%s lo puede cambiar otro usuario: no me fío de él" % ruta)


def pasarela():
    """La pasarela de este servidor (o de este usuario), o None si no está instalada."""
    global _pasarela
    if _pasarela is not None:
        return _pasarela
    ruta = ruta_pasarela_ini()
    if not os.path.exists(ruta):
        return None
    de_fiar(ruta)
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(ruta)
        codigo = ini.get("instalador", "codigo")
        datos = {"ini": ruta, "tokens": ini.get("pasarela", "tokens"), "cert": ini.get("pasarela", "certificado"),
                 "puerto": ini.getint("pasarela", "puerto"), "direccion": ini.get("qr", "direccion")}
    except (configparser.Error, ValueError) as error:
        fallar("%s no se puede leer: %s" % (ruta, error))
    for camino in (codigo, os.path.join(codigo, "hehermes_servidor")):
        de_fiar(camino)
    if codigo not in sys.path:
        sys.path.insert(0, codigo)
    from hehermes_servidor import pasarela as modulo_pasarela, qr as modulo_qr, tokens as modulo_tokens
    datos.update(modulo_tokens=modulo_tokens, modulo_qr=modulo_qr, modulo_pasarela=modulo_pasarela)
    _pasarela = datos
    return datos


def en_la_pasarela(nombre):
    p = pasarela()
    if p is None:
        return False
    try:
        return any(t["nombre"] == nombre for t in p["modulo_tokens"].lista(p["tokens"]))
    except ValueError as error:
        fallar(str(error))


def una_persona_en_un_terminal():
    """El QR de la pasarela lleva el token: solo una persona, en un terminal, y como root, con sudo."""
    return sys.stdout.isatty() and (os.geteuid() != 0 or bool(os.environ.get("SUDO_USER")))


def huella_de_la_pasarela(p):
    import ssl
    try:
        with open(p["cert"]) as f:
            return p["modulo_pasarela"].huella_de_der(ssl.PEM_cert_to_DER_cert(f.read()))
    except (OSError, ValueError) as error:
        fallar("no puedo leer el certificado de la pasarela (%s): %s" % (p["cert"], error))


def pintar_qr_tls(p, nombre, token, huella):
    texto = p["modulo_tokens"].texto_qr(p["direccion"], p["puerto"], huella, token)
    sys.stdout.write(p["modulo_qr"].terminal(texto))
    print("Escanéalo desde la app HeHermes Mensajes. Lleva el token de «%s»: ni lo compartas ni le hagas captura. "
          "No se puede volver a pintar: si hace falta otro, hehermes-dispositivo rotar %s (y el de antes deja de "
          "valer)." % (nombre, nombre))


def exigir_terminal(que):
    if not una_persona_en_un_terminal():
        fallar("%s pinta el QR, que lleva el token del iPhone: solo %s desde un terminal interactivo, y no he cambiado "
               "nada" % (que, "con sudo" if os.geteuid() == 0 else "tú"))


def alta_tls(nombre):
    p = pasarela()
    if p is None:
        fallar("la pasarela TLS no está instalada (no está %s). Se instala con el comando de la app, o con: "
               "sudo hehermes-servidor instalar" % ruta_pasarela_ini())
    exigir_terminal("El alta de la pasarela")
    huella = huella_de_la_pasarela(p)
    try:
        token = p["modulo_tokens"].alta(p["tokens"], nombre)
    except ValueError as error:
        fallar(str(error))
    print("Alta de «%s» en la pasarela TLS (puerto %d)." % (nombre, p["puerto"]))
    pintar_qr_tls(p, nombre, token, huella)


def baja_tls(nombre):
    p = pasarela()
    try:
        quitado = p["modulo_tokens"].baja(p["tokens"], nombre)
    except ValueError as error:
        fallar(str(error))
    if not quitado:
        fallar("no hay ningún iPhone «%s» en la pasarela" % nombre)
    print("Baja de «%s» en la pasarela. Su token ya no vale, y si tenía una conexión abierta, la pasarela la corta en "
          "un segundo." % nombre)


def rotar_tls(nombre):
    p = pasarela()
    exigir_terminal("Rotar en la pasarela")
    huella = huella_de_la_pasarela(p)
    try:
        token = p["modulo_tokens"].rotar(p["tokens"], nombre)
    except ValueError as error:
        fallar(str(error))
    print("Token de «%s» cambiado: el de antes ya no vale, y su conexión se ha cortado." % nombre)
    pintar_qr_tls(p, nombre, token, huella)


def modo_de(args, nombre):
    """«tls» o «vpn» para una baja: lo que se pida, o donde esté. Si está en los dos, que se diga."""
    vpn_pedida = "--vpn" in args or "--ikev2" in args
    if "--tls" in args and vpn_pedida:
        fallar("--tls o --ikev2, no los dos")
    if "--tls" in args:
        return "tls"
    if vpn_pedida:
        return "vpn"
    tls = en_la_pasarela(nombre)
    vpn = os.geteuid() == 0 and buscar(leer_registro(), nombre) is not None
    if tls and vpn:
        fallar("«%s» está en la pasarela y en la VPN de antes: di cuál con --tls o --ikev2" % nombre)
    return "tls" if tls else "vpn"


def de_la_vpn(nombre):
    """El alta de la VPN de antes con ese nombre, si la hay (solo root ve su registro)."""
    return buscar(leer_registro(), nombre) if os.geteuid() == 0 else None


# MARK: Órdenes


def ruta_conf(nombre):
    return os.path.join(DIR_HH, nombre + ".conf")


def cmd_alta(args):
    """Solo en la pasarela. `--tls` se sigue aceptando: es lo que enseñaban las versiones de antes y lo que enseña la
    app a quien ya tiene el instalador."""
    if not args:
        fallar("falta el nombre")
    nombre = args[0]
    if not NOMBRE_VALIDO.match(nombre):
        fallar("nombre no válido (minúsculas, números y guiones, hasta 31)")
    resto = args[1:]
    if "--ikev2" in resto or "--vpn" in resto:
        fallar("--ikev2 ya no existe: " + SIN_VPN)
    if "--pubkey" in resto or "--servidor" in resto:
        fallar(SIN_WIREGUARD)
    if resto not in ([], ["--tls"]):
        fallar("uso: alta <nombre> [--tls]")
    alta_tls(nombre)


def cmd_lista(_args):
    """Todos, los de la pasarela y los que queden de la VPN de antes, cada uno con su modo (tls, ikev2 o wireguard) en
    la segunda columna."""
    p = pasarela()
    de_la_pasarela = []
    if p is not None:
        try:
            de_la_pasarela = p["modulo_tokens"].lista(p["tokens"])
        except ValueError as error:
            fallar(str(error))
        for t in de_la_pasarela:
            rotado = ("  rotado " + t["rotado"]) if t.get("rotado") else ""
            print("%-20s %-9s %-12s alta %s  puerto %d%s" % (t["nombre"], "tls", "-", t.get("alta", "?"), p["puerto"],
                                                             rotado))
        if os.geteuid() != 0 or not os.path.exists(REGISTRO):
            if not de_la_pasarela:
                print("Sin dispositivos.")
            return
    registro = leer_registro()
    handshakes = {}
    if subprocess.run(["ip", "link", "show", INTERFAZ], capture_output=True).returncode == 0:
        for linea in ejecutar("wg", "show", INTERFAZ, "latest-handshakes").splitlines():
            clave, _, t = linea.partition("\t")
            handshakes[clave] = int(t or 0)
    if not registro["dispositivos"]:
        if not de_la_pasarela:
            print("Sin dispositivos.")
        return
    sas = sas_ikev2() if any(tipo(d) == "ikev2" for d in activos(registro)) else {}
    for d in registro["dispositivos"]:
        if d.get("baja"):
            estado = "baja " + d["baja"]
        elif tipo(d) == "ikev2":
            if sas is None:
                estado = "sin saber (swanctl no contesta)"
            else:
                sa = sas.get(d["conexion"])
                estado = "SA viva" if sa == "ESTABLISHED" else ("SA " + sa.lower() if sa else "sin SA")
        else:
            t = handshakes.get(d["clavePublica"], 0)
            estado = ("último contacto " + datetime.datetime.fromtimestamp(t, datetime.timezone.utc).isoformat()) if t else "sin contacto"
        pendiente = "  (.conf con clave privada aún en el VPS)" if os.path.exists(ruta_conf(d["nombre"])) else ""
        print("%-20s %-9s %-12s alta %s  %s%s" % (d["nombre"], tipo(d), d["ip"], d["alta"], estado, pendiente))


def cmd_baja(args):
    if not 1 <= len(args) <= 2 or any(a not in ("--tls", "--ikev2", "--vpn") for a in args[1:]):
        fallar("uso: baja <nombre> [--tls|--ikev2]")
    if modo_de(args[1:], args[0]) == "tls":
        if pasarela() is None:
            fallar("la pasarela TLS no está instalada")
        baja_tls(args[0])
        return
    if os.geteuid() != 0 and pasarela() is not None:
        # Sin root, solo lo de la pasarela de este usuario (main ya ha dejado fuera lo demás).
        fallar("lo de la VPN hay que ejecutarlo como root (sudo)")
    args = args[:1]
    registro = leer_registro()
    d = buscar(registro, args[0])
    if not d:
        fallar("no hay ningún dispositivo activo con ese nombre")
    d["baja"] = ahora()
    guardar_registro(registro)
    if tipo(d) == "ikev2":
        baja_ikev2(d)
    else:
        aplicar(registro)
    if os.path.exists(ruta_conf(d["nombre"])):
        os.unlink(ruta_conf(d["nombre"]))
    print("Baja de «%s» (%s). Ya no puede conectarse." % (d["nombre"], d["ip"]))


def cmd_rotar(args):
    if not 1 <= len(args) <= 2 or any(a not in ("--tls", "--ikev2", "--vpn") for a in args[1:]):
        fallar("uso: rotar <nombre> [--tls]")
    nombre = args[0]
    if "--ikev2" in args[1:] or "--vpn" in args[1:]:
        fallar("--ikev2 ya no existe: " + SIN_VPN)
    if en_la_pasarela(nombre):
        rotar_tls(nombre)
        return
    d = de_la_vpn(nombre)
    if d is not None:
