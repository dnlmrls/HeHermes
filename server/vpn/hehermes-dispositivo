                       and n not in {d["conexion"] for d in ikev2})
        print("%-16s %d de %d vivas%s%s" % ("SA IKEv2", len(conectados), len(ikev2),
                                            (": " + ", ".join(conectados)) if conectados else "",
                                            ("; y fuera del registro: " + ", ".join(otras)) if otras else ""))


