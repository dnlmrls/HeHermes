#: Lo que se puede hacer sin root: lo de la pasarela de ese usuario.
SIN_ROOT = ("alta", "baja", "rotar", "lista", "qr")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMANDOS:
        print(__doc__.strip().split("\n\n")[1])
        sys.exit(2)
    os.umask(0o077)
    if os.geteuid() != 0:
        if sys.argv[1] not in SIN_ROOT or pasarela() is None:
            fallar("hay que ejecutarlo como root (sudo)")
        COMANDOS[sys.argv[1]](sys.argv[2:])
        return
    # Como root, sin crear nada de la VPN: solo se leen (y se dan de baja) las altas que queden.
    aplicar_servidor_ini()
    COMANDOS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
