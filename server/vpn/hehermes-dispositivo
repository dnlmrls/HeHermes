def ruta_conf(nombre):
    return os.path.join(DIR_HH, nombre + ".conf")


def cmd_alta(args):
    if not args:
        fallar("falta el nombre")
    nombre = args[0]
    if not NOMBRE_VALIDO.match(nombre):
        fallar("nombre no válido (minúsculas, números y guiones, hasta 31)")
    uso = ("uso: alta <nombre> [--pubkey <clave pública>] [--servidor <dirección>] | "
           "alta <nombre> --ikev2 [--servidor <dirección>]")
    opciones, resto = {}, list(args[1:])
    while resto:
        opcion = resto.pop(0)
        if opcion in opciones:
            fallar(uso)
        if opcion == "--ikev2":
            opciones[opcion] = True
        elif opcion in ("--pubkey", "--servidor") and resto:
            opciones[opcion] = resto.pop(0)
        else:
            fallar(uso)
    if "--ikev2" in opciones:
        if "--pubkey" in opciones:
            fallar(uso)
        alta_ikev2(nombre, direccion_del_servidor(opciones.get("--servidor")))
        return
    pubkey = opciones.get("--pubkey")
    if pubkey is not None and not CLAVE_VALIDA.match(pubkey):
        fallar("la clave pública no tiene formato WireGuard")
    # Antes de tocar el registro: sin dirección no hay Endpoint, y un alta a medias no serviría de nada.
    servidor = direccion_del_servidor(opciones.get("--servidor"))
    registro = leer_registro()
    if buscar(registro, nombre):
        fallar("ya hay un dispositivo activo con ese nombre; da de baja el anterior")
    if pubkey and any(d.get("clavePublica") == pubkey for d in activos(registro)):
        fallar("esa clave pública ya está dada de alta")
    ip = siguiente_ip(registro)
    privada = None
    if pubkey is None:
        privada = ejecutar("wg", "genkey").strip()
        pubkey = ejecutar("wg", "pubkey", entrada=privada + "\n").strip()
    d = {"nombre": nombre, "ip": ip, "clavePublica": pubkey, "alta": ahora(),
         "origen": "servidor" if privada else "dispositivo"}
    registro["dispositivos"].append(d)
    guardar_registro(registro)
    aplicar(registro)
    if privada:
        escribir_privado(ruta_conf(nombre), (
            "[Interface]\nPrivateKey = %s\nAddress = %s/32\n\n"
            "[Peer]\nPublicKey = %s\nEndpoint = %s\nAllowedIPs = %s/32\n"
        ) % (privada, ip, publica_servidor(), endpoint(servidor), IP_SERVIDOR))
        print("Alta de «%s» con IP %s. La clave privada se ha quedado en el VPS (%s)." % (nombre, ip, ruta_conf(nombre)))
        print("Para importarla en la app WireGuard, desde tu terminal:  sudo hehermes-dispositivo qr %s" % nombre)
        print("Cuando esté importada:  sudo hehermes-dispositivo limpiar %s" % nombre)
    else:
        print(json.dumps(fichero_hehermes(d, servidor), indent=2, ensure_ascii=False))


