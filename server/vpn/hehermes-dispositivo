    vivos = activos(leer_registro())
    ikev2 = [d for d in vivos if tipo(d) == "ikev2"]
    print("%-16s %d activos (%d wireguard, %d ikev2)" % ("dispositivos", len(vivos), len(vivos) - len(ikev2),
                                                         len(ikev2)))
