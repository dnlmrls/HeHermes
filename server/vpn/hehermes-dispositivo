def cmd_clave(args):
    # --solo-vigia es para el instalador de los avisos: la copia del vigía y nada más. Así una pasada del instalador en
    # la que no cambia nada no recarga nginx (el instalador solo lo recarga cuando cambia lo suyo).
    if args not in ([], ["--solo-vigia"]):
        fallar("uso: hehermes-dispositivo clave [--solo-vigia]")
    solo_vigia = bool(args)
    with open(ENV_HERMES) as f:
        clave = leer_clave_del_env(f.read())
    if not clave:
        fallar("no encuentro API_SERVER_KEY en " + ENV_HERMES)
    if not re.match(r"^[\x21-\x7e]+$", clave) or '"' in clave or "\\" in clave:
        fallar("la clave tiene caracteres que no sé escribir en nginx")
    if not solo_vigia:
        escribir_privado(BEARER_NGINX, 'proxy_set_header Authorization "Bearer %s";\n' % clave)
        if subprocess.run(["systemctl", "is-active", "--quiet", "nginx"]).returncode == 0:
            ejecutar("nginx", "-t")
            ejecutar("systemctl", "reload", "nginx")
        print("Clave del api_server copiada a %s (0600). nginx la usa desde ya." % BEARER_NGINX)
    if copiar_clave_al_vigia(clave):
        print("%s %s (0600, %s): el vigía de avisos la usa desde ya." % (
            "Clave del api_server copiada a" if solo_vigia else "Y a", CLAVE_VIGIA, USUARIO_VIGIA))
    elif solo_vigia:
        fallar("no existe %s: el vigía de avisos no está instalado" % DIR_VIGIA)


def copiar_clave_al_vigia(clave):
    """La copia de la clave del vigía de avisos, si está instalado. Es el mismo camino que la de nginx a propósito:
    cuando la clave cambia, `hehermes-dispositivo clave` lo arregla todo. El vigía la lee al arrancar, así que se
    reinicia si está en marcha; si la copia ya estaba al día, ni se escribe ni se reinicia (el instalador la pide en
    cada pasada). Nunca se imprime."""
    if not os.path.isdir(DIR_VIGIA):
        return False
    try:
        usuario = pwd.getpwnam(USUARIO_VIGIA)
    except KeyError:
        fallar("existe %s pero no el usuario %s: vuelve a ejecutar el instalador de los avisos" % (DIR_VIGIA,
                                                                                                   USUARIO_VIGIA))
    contenido = clave + "\n"
    if copia_al_dia(CLAVE_VIGIA, contenido, usuario):
        return True
    escribir_privado(CLAVE_VIGIA, contenido, uid=usuario.pw_uid, gid=usuario.pw_gid)
    if subprocess.run(["systemctl", "is-active", "--quiet", SERVICIO_VIGIA]).returncode == 0:
        ejecutar("systemctl", "restart", SERVICIO_VIGIA)
    return True


def copia_al_dia(ruta, contenido, usuario):
    """Si ya hay en `ruta` un fichero normal con ese contenido, de ese usuario y 0600. Sin seguir enlaces."""
    try:
        fd = os.open(ruta, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return False
    with os.fdopen(fd, "rb") as f:
        datos = os.fstat(f.fileno())
        return (stat.S_ISREG(datos.st_mode) and stat.S_IMODE(datos.st_mode) == 0o600
                and (datos.st_uid, datos.st_gid) == (usuario.pw_uid, usuario.pw_gid)
                and f.read() == contenido.encode())


